{
  "name": "playdex-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:landing": "vite --config landing/vite.config.ts",
    "build:landing": "vite build --config landing/vite.config.ts",
    "preview:landing": "vite preview --config landing/vite.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:csp": "bun scripts/check-csp.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "10.4.23",
    "jsdom": "^26.1.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "~7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "8.5.31",
    "postcss-selector-parser": "7.1.7"
  }
}
