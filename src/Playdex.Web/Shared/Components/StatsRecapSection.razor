@using System.Globalization
@using Microsoft.AspNetCore.Components

<div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="flex flex-wrap items-baseline gap-3">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                @Title
            </p>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-700 dark:text-slate-200">
                @Subtitle
            </p>
        </div>
        @if (OnOpenRecap.HasDelegate)
        {
            <button type="button"
                    @onclick="OnOpenRecap"
                    class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 text-slate-600 dark:text-slate-200 transition hover:border-emerald-300 hover:text-emerald-700 dark:hover:text-emerald-200"
                    aria-label="Open recap"
                    title="Open recap">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     class="lucide lucide-chart-column h-4 w-4"
                     aria-hidden="true">
                    <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
                    <path d="M18 17V9"></path>
                    <path d="M13 17V5"></path>
                    <path d="M8 17v-3"></path>
                </svg>
            </button>
        }
    </div>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
        @foreach (var stat in Summary)
        {
            <div @key="stat.Label"
                 class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
                <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                    @stat.Label
                </p>
                <p class="mt-2 text-lg font-semibold text-slate-900 dark:text-white">
                    @stat.Value
                </p>
            </div>
        }
    </div>
    <div class="mt-5 grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                Platform distribution
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-4">
                <StatsPieChart Segments="@PieSegments" Colors="@Colors" Size="168" />
                <div class="flex-1 space-y-2 text-xs text-slate-600 dark:text-slate-300">
                    @for (var index = 0; index < Platforms.Count; index++)
                    {
                        var item = Platforms[index];
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex items-center gap-2">
                                <span class="h-2 w-2 rounded-full" style="@ColorStyle(index)"></span>
                                <span>@item.Label</span>
                            </div>
                            <span>@Invariant(item.Value)% · @item.Hours</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                Top 5 games
            </p>
            <div class="mt-4 space-y-3">
                @for (var index = 0; index < TopGames.Count; index++)
                {
                    var game = TopGames[index];
                    <div @key="@($"{game.GameId}-{game.Title}")" class="flex items-center justify-between text-sm">
                        <div class="flex items-center gap-3">
                            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                                @((index + 1).ToString("00", CultureInfo.InvariantCulture))
                            </span>
                            @if (OnGameSelect.HasDelegate)
                            {
                                <button type="button"
                                        @onclick="() => OnGameSelect.InvokeAsync(game.GameId)"
                                        class="text-left font-semibold text-slate-900 dark:text-white transition hover:text-emerald-700 dark:hover:text-emerald-200">
                                    @game.Title
                                </button>
                            }
                            else
                            {
                                <span class="font-semibold text-slate-900 dark:text-white">
                                    @game.Title
                                </span>
                            }
                        </div>
                        <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-200">
                            @game.Hours
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public string Subtitle { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<(string Label, string Value)> Summary { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<(string Label, double Value, string Hours)> Platforms { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<(string GameId, string Title, string Hours)> TopGames { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Colors { get; set; } = [];

    [Parameter]
    public EventCallback<string> OnGameSelect { get; set; }

    [Parameter]
    public EventCallback OnOpenRecap { get; set; }

    private IReadOnlyList<(string Label, double Value)> PieSegments =>
        Platforms.Select(item => (item.Label, item.Value)).ToArray();

    private string? ColorStyle(int index) =>
        Colors.Count == 0 ? null : $"background-color: {Colors[index % Colors.Count]}";

    private static string Invariant(double value) =>
        value.ToString(CultureInfo.InvariantCulture);
}
