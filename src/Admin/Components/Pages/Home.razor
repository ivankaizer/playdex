@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Administrator")]
@using Admin.Features
@using Admin.Infrastructure
@using Playdex.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@inject IDashboardOperations Operations
@inject BrowserTimeZone Time
@inject TimeProvider Clock
@inject AuthenticationStateProvider Authentication
@implements IAsyncDisposable

<PageTitle>Dashboard</PageTitle>
<div class="dashboard-heading">
    <RadzenHeading Size="H1" Text="Dashboard" />
    <div class="dashboard-refresh">
        <span>@(_snapshot is null ? "Monitoring all accounts" : $"Updated {Time.ToLocal(_snapshot.UpdatedAt):yyyy-MM-dd HH:mm:ss} · every 30s")</span>
        <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="Refresh" Disabled="@_loading" />
    </div>
</div>
@if (_loading) { <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" /> }
@if (_error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert>
    <RadzenButton Text="Retry" Click="Refresh" Disabled="@_loading" />
}
@if (_snapshot is not null)
{
    <div class="dashboard-counters">
        <a href="/sessions?status=live" class="dashboard-counter"><RadzenIcon Icon="play_circle" /><strong>@_snapshot.Counts.LiveSessions</strong><span>Live sessions</span></a>
        <a href="/sessions?status=live" class="dashboard-counter"><RadzenIcon Icon="group" /><strong>@_snapshot.Counts.LiveUsers</strong><span>Users playing</span></a>
        <a href="@TodayLink" class="dashboard-counter"><RadzenIcon Icon="today" /><strong>@_snapshot.Counts.SessionsToday</strong><span>Sessions today</span></a>
        <a href="@ErrorsLink" class="dashboard-counter"><RadzenIcon Icon="error_outline" /><strong>@_snapshot.Counts.AiErrors</strong><span>AI errors · 24h</span></a>
    </div>
    <section aria-label="Live sessions">
        <div class="dashboard-section-heading"><RadzenHeading Size="H2" Text="Live sessions" /><span>Longest running first</span></div>
        <form class="session-toolbar dashboard-filters" @onsubmit="ApplyFilters" @onsubmit:preventDefault>
            <RadzenTextBox @bind-Value="_query" Placeholder="Search user, game or account" aria-label="Search live sessions" />
            <RadzenDropDown @bind-Value="_platform" Data="@_snapshot.Platforms" TextProperty="Name" ValueProperty="Key" AllowClear="true" Placeholder="All platforms" aria-label="Live platform" />
            <button type="submit" class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default" disabled="@_loading"><span class="rz-button-box"><RadzenIcon Icon="search" /><span class="rz-button-text">Search</span></span></button>
        </form>
        @if (_snapshot.LiveSessions.Count == 0)
        { <RadzenAlert AlertStyle="AlertStyle.Info">@(_appliedQuery.Length == 0 && _appliedPlatform is null ? "No live sessions right now." : "No live sessions match these filters.")</RadzenAlert> }
        else
        {
            <div class="dashboard-table">
                <RadzenDataGrid Data="@_snapshot.LiveSessions" TItem="DashboardSession" AllowPaging="true" PageSize="20">
                    <Columns>
                        <RadzenDataGridColumn TItem="DashboardSession" Property="Email" Title="User" Width="170px" />
                        <RadzenDataGridColumn TItem="DashboardSession" Title="Game" Width="200px"><Template Context="session">
                            <div class="dashboard-game">@if (!string.IsNullOrWhiteSpace(session.CapsuleUrl)) { <img src="@session.CapsuleUrl" alt="" loading="lazy" /> } else { <span class="dashboard-cover"><RadzenIcon Icon="sports_esports" /></span> }<span>@session.Game</span></div>
                        </Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DashboardSession" Title="Platform" Width="150px"><Template Context="session"><div>@session.Platform</div><small>@(session.AccountId ?? "—")</small></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DashboardSession" Property="Source" Title="Source" Width="85px" />
                        <RadzenDataGridColumn TItem="DashboardSession" Title="Elapsed" Width="85px"><Template Context="session">@Duration(session)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DashboardSession" Title="Started" Width="110px"><Template Context="session">@Time.Format(session.StartedAt)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DashboardSession" Title="Last poll" Width="110px"><Template Context="session">@(session.Source != CaptureMethod.Polling ? "Not polled" : session.LastPolledAt is null ? "No poll recorded" : Time.Format(session.LastPolledAt))</Template></RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    </section>
    <div class="dashboard-activity">
        <section aria-label="Recent ended sessions">
            <div class="dashboard-section-heading"><RadzenHeading Size="H2" Text="Recently ended" /><a href="/sessions?status=ended">View all</a></div>
            @if (_snapshot.EndedSessions.Count == 0) { <RadzenAlert AlertStyle="AlertStyle.Info">No ended sessions yet.</RadzenAlert> }
            else
            {
                @foreach (var session in _snapshot.EndedSessions)
                {
                    <div class="dashboard-activity-row"><div><strong>@session.Game</strong><small>@session.Email · @session.Platform</small></div><div class="dashboard-activity-time"><strong>@Duration(session)</strong><small>@Time.Format(session.EndedAt)</small></div></div>
                }
            }
        </section>
        <section aria-label="Recent AI errors">
            <div class="dashboard-section-heading"><RadzenHeading Size="H2" Text="Recent AI errors" /><a href="/ai-generations?status=errors">View all</a></div>
            @if (_snapshot.FailedGenerations.Count == 0) { <RadzenAlert AlertStyle="AlertStyle.Info">No failed AI generations.</RadzenAlert> }
            else
            {
                @foreach (var generation in _snapshot.FailedGenerations)
                {
                    <a class="dashboard-activity-row" href="/ai-generations?id=@generation.Id"><div><strong>@generation.Email</strong><small>@generation.Model</small></div><div class="dashboard-activity-time"><span class="dashboard-outcome">@generation.Status</span><small>@Time.Format(generation.CreatedAt)</small></div></a>
                }
            }
        </section>
    </div>
}

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _refreshLoop;
    private DashboardSnapshot? _snapshot;
    private bool _loading = true;
    private bool _disposed;
    private string? _error;
    private string _query = "", _appliedQuery = "";
    private string? _platform, _appliedPlatform;
    private (DateTimeOffset Start, DateTimeOffset End) _day;
    private string TodayLink => $"/sessions?from={Encode(_day.Start)}&to={Encode(_day.End)}";
    private string ErrorsLink => $"/ai-generations?status=errors&since={Encode(_snapshot!.UpdatedAt.AddHours(-24))}&until={Encode(_snapshot.UpdatedAt)}";
    private static string Encode(DateTimeOffset time) => Uri.EscapeDataString(time.ToString("O", System.Globalization.CultureInfo.InvariantCulture));
    private string Duration(DashboardSession session)
    {
        var minutes = (long)Math.Max(0, ((session.EndedAt ?? _snapshot!.UpdatedAt) - session.StartedAt).TotalMinutes);
        return FormattableString.Invariant($"{minutes / 60}h {minutes % 60}m");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Time.EnsureLoadedAsync();
        _loading = false;
        await Refresh();
        if (!_disposed) _refreshLoop = RefreshLoop();
    }
    private async Task ApplyFilters()
    {
        if (_loading || _disposed) return;
        _appliedQuery = _query.Trim();
        _appliedPlatform = _platform;
        await Refresh();
    }
    private async Task Refresh()
    {
        if (_loading || _disposed) return;
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var principal = (await Authentication.GetAuthenticationStateAsync()).User;
            var day = Time.DayRange(Clock.GetUtcNow());
            var result = await Operations.Read(principal, _appliedQuery, _appliedPlatform, day.Start, day.End, _lifetime.Token);
            if (!_disposed) { _snapshot = result; _day = day; _error = null; }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (UnauthorizedAccessException) { _snapshot = null; _error = "Administrator access is required."; }
        catch (Exception) { _error = "Could not refresh the dashboard. Previously loaded data may be out of date."; }
        finally { _loading = false; if (!_disposed) await InvokeAsync(StateHasChanged); }
    }
    private async Task RefreshLoop()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30), Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token)) await InvokeAsync(Refresh);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await _lifetime.CancelAsync();
        if (_refreshLoop is not null) await _refreshLoop;
        _lifetime.Dispose();
    }
}
