@page "/games"
@attribute [Authorize(Policy = "Administrator")]
@using Admin.Features
@using Microsoft.AspNetCore.Components.Authorization
@inject IAdminOperations Operations
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAdminInteractions Interactions
<PageTitle>Games</PageTitle>
<RadzenHeading Size="H1" Text="Games"/>
<div class="session-toolbar">
    <RadzenTextBox @bind-Value="_query" Placeholder="Title, capsule URL, or game identifier"/>
    <RadzenButton Text="Search" Click="SearchAsync" Disabled="@_loading"/>
</div>
@if (_error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert>
}
else if (_loading)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"/>
}
else if (_games.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">No games found.</RadzenAlert>
}
else
{
    <RadzenDataGrid Data="@_games" TItem="GameSummary" RowSelect="SelectGame">
        <Columns>
            <RadzenDataGridColumn TItem="GameSummary" Property="Id" Title="Id"/>
            <RadzenDataGridColumn TItem="GameSummary" Property="Title" Title="Title"/>
            <RadzenDataGridColumn TItem="GameSummary" Property="CapsuleUrl" Title="Capsule URL"/>
            <RadzenDataGridColumn TItem="GameSummary" Property="TitleLocked" Title="Title locked"/>
            <RadzenDataGridColumn TItem="GameSummary" Property="CapsuleUrlLocked" Title="Image locked"/>
        </Columns>
    </RadzenDataGrid>
    @if (_selected is not null)
    {
        <RadzenCard>
            <RadzenHeading Size="H2" Text="Edit game"/>
            <RadzenTextBox @bind-Value="_title" Placeholder="Title"/>
            <RadzenTextBox @bind-Value="_capsuleUrl" Placeholder="Capsule URL (clear to remove)"/>
            <label><input type="checkbox" @bind="_titleLocked"/> Title locked</label>
            <label><input type="checkbox" @bind="_capsuleUrlLocked"/> Image locked</label>
            <RadzenButton Text="Save" Click="SaveAsync" Disabled="@_saving"/>
        </RadzenCard>
    }

    @if (_games.Count > 1)
    {
        <RadzenCard>
            <RadzenHeading Size="H2" Text="Merge games"/>
            <RadzenDropDown @bind-Value="_sourceId" Data="@_games" TextProperty="Title" ValueProperty="Id"
                            Placeholder="Source game"/>
            <RadzenDropDown @bind-Value="_targetId" Data="@_games" TextProperty="Title" ValueProperty="Id"
                            Placeholder="Target game"/>
            <RadzenButton Text="Merge" Click="MergeAsync" Disabled="@_saving"/>
        </RadzenCard>
    }
}

@code {
    private string _query = "";
    private IReadOnlyList<GameSummary> _games = [];
    private GameSummary? _selected;
    private string _title = "";
    private string? _capsuleUrl;
    private bool _titleLocked;
    private bool _capsuleUrlLocked;
    private bool _loading;
    private bool _saving;
    private long? _sourceId;
    private long? _targetId;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true;
        _selected = null;
        try
        {
            _games = await Operations.ListGamesAsync();
            _error = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SearchAsync()
    {
        if (_loading) return;
        _loading = true;
        _selected = null;
        try
        {
            _games = await Operations.SearchGamesAsync(_query);
            _error = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectGame(GameSummary game)
    {
        _selected = game;
        _title = game.Title;
        _capsuleUrl = game.CapsuleUrl;
        _titleLocked = game.TitleLocked;
        _capsuleUrlLocked = game.CapsuleUrlLocked;
    }

    private async Task SaveAsync()
    {
        if (_selected is null || _saving) return;
        _saving = true;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var changed = await Operations.UpdateGameAsync(state.User, _selected.Id, _title, _title != _selected.Title, _capsuleUrl, _capsuleUrl != _selected.CapsuleUrl, _titleLocked, _capsuleUrlLocked);
            if (!changed) throw new KeyNotFoundException("Game not found.");
            Interactions.Success("Game updated", "The game metadata was saved.");
            await SearchAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            Interactions.ShowError("Game update failed", exception.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task MergeAsync()
    {
        if (_saving || !_sourceId.HasValue || !_targetId.HasValue || _sourceId == _targetId)
        {
            _error = "Select two different games.";
            return;
        }

        if (!await Interactions.ConfirmAsync("This permanently removes the source game and reassigns its relationships. Continue?", "Confirm game merge")) return;
        _saving = true;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await Operations.MergeGamesAsync(state.User, _sourceId.Value, _targetId.Value);
            Interactions.Success("Games merged", "The source game was merged into the target.");
            _sourceId = _targetId = null;
            await SearchAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            Interactions.ShowError("Merge failed", exception.Message);
        }
        finally
        {
            _saving = false;
        }
    }

}
