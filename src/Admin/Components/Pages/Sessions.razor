@page "/sessions"
@attribute [Authorize(Policy = "Administrator")]
@using Admin.Features
@using Admin.Infrastructure
@using Microsoft.AspNetCore.Components.Authorization
@inject IAdminOperations Operations
@inject IAdminInteractions Interactions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BrowserTimeZone Time
<PageTitle>Sessions</PageTitle>
<RadzenHeading Size="H1" Text="Sessions"/>
@if (From is not null || To is not null)
{
    <p>Started @Time.Format(ParseDate(From)) – @Time.Format(ParseDate(To)) · <a href="/sessions">All sessions</a></p>
}
<div class="session-toolbar">
    <RadzenTextBox @bind-Value="_query" Placeholder="Email, game, account, or platform"/>
    <RadzenDropDown @bind-Value="_status" Data="@StatusOptions" TextProperty="Label" ValueProperty="Value"
                    AllowClear="true" Placeholder="Status"/>
    <RadzenButton Text="Search" Click="SearchAsync" Disabled="@_loading"/>
</div>
<div class="session-toolbar admin-transfer-toolbar">
    <RadzenDropDown @bind-Value="_target" Data="@_integrations" TextProperty="AccountId" ValueProperty="Id"
                    AllowClear="true" Placeholder="Target integration"/>
    <RadzenButton Text="Transfer selected" Click="TransferAsync"
                  Disabled="@(_loading || _selected.Count == 0 || _target is null)"/>
</div>
@if (_error is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert>
}
else if (_loading || _result is null)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"/>
}
else if (_result.Sessions.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">No sessions found.</RadzenAlert>
}
else
{
    <RadzenDataGrid Data="@_result.Sessions" TItem="SessionSummary" AllowPaging="false">
        <Columns>
            <RadzenDataGridColumn TItem="SessionSummary" Title="Select" Width="80px" TextAlign="TextAlign.Center">
                <Template Context="session"><input type="checkbox" checked="@_selected.Contains(session.Id)"
                                                   @onchange="@(_ => Toggle(session.Id))"/></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessionSummary" Property="Email" Title="Owner"/>
            <RadzenDataGridColumn TItem="SessionSummary" Property="Game" Title="Game"/>
            <RadzenDataGridColumn TItem="SessionSummary" Property="Platform" Title="Platform"/>
            <RadzenDataGridColumn TItem="SessionSummary" Title="Started">
                <Template Context="session">@Time.Format(session.StartedAt)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessionSummary" Title="State">
                <Template Context="session">@(session.Live ? "Live" : "Ended")</Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <div>Total: @_result.Total | Page: @(_result.Page + 1)</div>
    <div class="admin-actions admin-pagination">
    <RadzenButton Text="Previous" Click="@(() => GoToPageAsync(_result.Page - 1))"
                  Disabled="@(_result.Page == 0 || _loading)"/>
    <RadzenButton Text="Next" Click="@(() => GoToPageAsync(_result.Page + 1))"
                  Disabled="@((_result.Page + 1) * 25 >= _result.Total || _loading)"/>
    </div>
}

@code {
    private static DateTimeOffset? ParseDate(string? value) => DateTimeOffset.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date) ? date : null;
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    private sealed record StatusOption(string Label, string Value);

    private static readonly IReadOnlyList<StatusOption> StatusOptions =
        [new("Live", "live"), new("Ended", "ended")];

    private bool _scopeInitialized;
    private (string? Status, string? From, string? To) _scope;
    private string _query = "";
    private string? _status;
    private long? _target;
    private IReadOnlyList<IntegrationSummary> _integrations = [];
    private SessionSearchResult? _result;
    private readonly HashSet<long> _selected = [];
    private bool _loading;
    private TaskCompletionSource? _idle;
    private long _scopeVersion;
    private void SetLoading(bool loading)
    {
        _loading = loading;
        if (loading) _idle = new(TaskCreationOptions.RunContinuationsAsynchronously);
        else _idle?.TrySetResult();
    }
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Time.EnsureLoadedAsync();
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _integrations = await Operations.GetIntegrationsAsync(state.User);
    }

    protected override async Task OnParametersSetAsync()
    {
        var scope = (Status, From, To);
        if (_scopeInitialized && scope == _scope) return;
        _scopeInitialized = true;
        _scope = scope;
        var version = ++_scopeVersion;
        while (_loading && _idle is not null) await _idle.Task;
        if (version != _scopeVersion) return;
        _status = Status;
        await SearchAsync();
    }

    private void Toggle(long id)
    {
        if (!_selected.Add(id)) _selected.Remove(id);
    }

    private async Task SearchAsync() => await GoToPageAsync(0);

    private async Task GoToPageAsync(int page)
    {
        if (page < 0 || _loading) return;
        SetLoading(true);
        var version = _scopeVersion;
        try
        {
            var result = await Operations.SearchSessionsPageAsync(_query, page, _status, startedFrom: ParseDate(From), startedBefore: ParseDate(To));
            if (version != _scopeVersion) return;
            _result = result;
            _selected.Clear();
            _error = null;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            SetLoading(false);
        }
    }

    private async Task TransferAsync()
    {
        if (_loading || _target is null || _selected.Count == 0) return;
        var version = _scopeVersion;
        if (!await Interactions.ConfirmAsync($"Transfer {_selected.Count} selected sessions?", "Confirm transfer")) return;
        if (_loading || version != _scopeVersion) return;
        SetLoading(true);
        var reload = false;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var count = await Operations.TransferSessionsAsync(state.User, _selected, _target.Value);
            Interactions.Success("Sessions transferred", $"Transferred {count} sessions.");
            reload = true;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            Interactions.ShowError("Transfer failed", exception.Message);
        }
        finally
        {
            SetLoading(false);
        }
        if (reload) await GoToPageAsync(_result?.Page ?? 0);
    }

}
