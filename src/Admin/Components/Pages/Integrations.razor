@page "/integrations"
@attribute [Authorize(Policy = "Administrator")]
@using Admin.Features
@using Microsoft.AspNetCore.Components.Authorization
@inject IAdminOperations Operations
@inject IAdminInteractions Interactions
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Integrations</PageTitle>
<RadzenHeading Size="H1" Text="Integrations" />
@if (_error is not null) { <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert><RadzenButton Text="Retry" Click="RefreshAsync" Disabled="@_loading" /> }
else if (_loading) { <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" /> }
else {
    <div class="session-toolbar">
    <RadzenDropDown @bind-Value="_filter" Data="@_platforms" TextProperty="Key" ValueProperty="Key" AllowClear="true" Placeholder="Filter platform" />
    <RadzenButton Text="Refresh" Click="@RefreshAsync" Disabled="@_loading" />
    </div>
    <RadzenDataGrid Data="@VisibleIntegrations" TItem="IntegrationSummary" AllowPaging="true" PageSize="25">
        <Columns><RadzenDataGridColumn TItem="IntegrationSummary" Property="Email" Title="Owner" />
            <RadzenDataGridColumn TItem="IntegrationSummary" Property="Platform" Title="Platform" />
            <RadzenDataGridColumn TItem="IntegrationSummary" Property="AccountId" Title="Account" />
            <RadzenDataGridColumn TItem="IntegrationSummary" Property="Active" Title="Active" Width="96px" TextAlign="TextAlign.Center">
                <Template Context="integration">@(integration.Active ? "Yes" : "No")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="IntegrationSummary" Title="API key"><Template Context="integration"><span class="admin-api-key">@(integration.ApiKey ?? "Not set")</span> <RadzenButton Text="Edit" Click="@(() => BeginEdit(integration))" /></Template></RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <RadzenHeading Size="H2" Text="Platform controls" />
    <div class="admin-actions">
    @foreach (var platform in _platforms) {
        <RadzenButton Text="@(platform.Enabled ? $"Disable {platform.Key}" : $"Enable {platform.Key}")" Click="@(() => TogglePlatformAsync(platform))" Disabled="@_loading" />
    }
    </div>
    @if (_editing is not null) {
        <RadzenCard class="admin-form-card"><RadzenHeading Size="H2" Text="@($"Edit credentials for {_editing.Email}")" />
            <div class="admin-form">
                <div class="admin-field">
                    <label class="admin-check"><input type="checkbox" @bind="_replaceApiKey" /> Replace or clear API key</label>
                    @if (_replaceApiKey) { <RadzenTextBox @bind-Value="_apiKey" Placeholder="API key (empty clears it)" aria-label="API key" /> }
                </div>
                <div class="admin-field">
                    <label class="admin-check"><input type="checkbox" @bind="_changeAccountId" /> Change account identifier</label>
                    @if (_changeAccountId) { <RadzenTextBox @bind-Value="_accountId" Placeholder="Account identifier" aria-label="Account identifier" /> }
                </div>
                <div class="admin-actions">
                    <RadzenButton Text="Save credentials" Click="SaveCredentialsAsync" Disabled="@_loading" />
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => _editing = null)" Disabled="@_loading" />
                </div>
            </div>
        </RadzenCard>
    }
}
@code {
    private IReadOnlyList<IntegrationSummary> _integrations = [];
    private IReadOnlyList<PlatformSummary> _platforms = [];
    private string? _filter;
    private bool _loading;
    private string? _error;
    private IntegrationSummary? _editing;
    private bool _replaceApiKey;
    private bool _changeAccountId;
    private string? _apiKey;
    private string? _accountId;
    private IEnumerable<IntegrationSummary> VisibleIntegrations => string.IsNullOrWhiteSpace(_filter) ? _integrations : _integrations.Where(row => row.Platform == _filter);

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _integrations = await Operations.GetIntegrationsAsync(state.User);
            _platforms = await Operations.GetPlatformSummariesAsync();
            _error = null;
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _loading = false; }
    }

    private async Task TogglePlatformAsync(PlatformSummary platform)
    {
        if (_loading) return;
        var enabled = !platform.Enabled;
        if (!await Interactions.ConfirmAsync($"Change all {platform.Total} integrations for {platform.Key}?", "Confirm platform change")) return;
        _loading = true;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var count = await Operations.SetPlatformEnabledAsync(state.User, platform.Key, enabled);
            Interactions.Success("Platform updated", $"Updated {count} integrations.");
            await RefreshAsync();
        }
        catch (Exception exception) { _error = exception.Message; Interactions.ShowError("Platform update failed", exception.Message); }
        finally { _loading = false; }
    }

    private void BeginEdit(IntegrationSummary integration)
    {
        _editing = integration;
        _replaceApiKey = false;
        _changeAccountId = false;
        _apiKey = integration.ApiKey;
        _accountId = integration.AccountId;
    }

    private async Task SaveCredentialsAsync()
    {
        if (_editing is null || _loading || (!_replaceApiKey && !_changeAccountId)) return;
        _loading = true;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var saved = await Operations.UpdateIntegrationAsync(state.User, _editing.Id, _replaceApiKey, string.IsNullOrEmpty(_apiKey) ? null : _apiKey, _changeAccountId, _accountId);
            if (!saved) throw new KeyNotFoundException("Integration not found.");
            Interactions.Success("Credentials updated", "The integration was refreshed.");
            _editing = null;
            await RefreshAsync();
        }
        catch (Exception exception) { _error = exception.Message; Interactions.ShowError("Credential update failed", exception.Message); }
        finally { _loading = false; }
    }
}
