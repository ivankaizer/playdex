@page "/login"
@layout Layout.MainLayout
@using Radzen
<PageTitle>Admin login</PageTitle>
<RadzenCard class="login-card"><h1>Admin login</h1>
    <form method="post" action="/auth/login">
        <RadzenTextBox Name="email" Placeholder="Email" />
        <RadzenPassword Name="password" Placeholder="Password" />
        <RadzenButton ButtonType="ButtonType.Submit" Text="Sign in" />
    </form>
</RadzenCard>
