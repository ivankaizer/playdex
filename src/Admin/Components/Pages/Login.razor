@page "/login"
@layout Layout.MainLayout
@using Radzen
<PageTitle>Admin login</PageTitle>
<RadzenCard class="login-card"><h1>Admin login</h1>
    <form method="post" action="/auth/login" class="admin-form">
        <div class="admin-field">
            <label for="admin-email">Email</label>
            <RadzenTextBox id="admin-email" Name="email" Placeholder="Email" autocomplete="username"/>
        </div>
        <div class="admin-field">
            <label for="admin-password">Password</label>
            <RadzenPassword id="admin-password" Name="password" Placeholder="Password" autocomplete="current-password"/>
        </div>
        <div class="admin-actions"><RadzenButton ButtonType="ButtonType.Submit" Text="Sign in"/></div>
    </form>
</RadzenCard>
