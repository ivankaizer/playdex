@using System.Text.Json
@using Admin.Features
@using Admin.Infrastructure
@inject BrowserTimeZone Time

<RadzenCard>
    <div class="generation-metadata">
        <strong>@Detail.Email</strong>
        <span>@Detail.Generation.Status · @Time.Format(Detail.Generation.CreatedAt)</span>
        <span>@Detail.Generation.Provider / @Detail.Generation.Model</span>
        <span>Reference date: @Detail.Generation.ReferenceDate.ToString("yyyy-MM-dd") · @Detail.Generation.Timezone</span>
        <small>Request: @Detail.Generation.RequestId · Generation: @Detail.Generation.Id</small>
    </div>
    @if (Detail.Generation.Error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger">@Detail.Generation.Error</RadzenAlert>
    }
    <div class="generation-comparison">
        <section>
            <RadzenHeading Size="H3" Text="User input" />
            <pre class="generation-text">@(string.IsNullOrWhiteSpace(Detail.Generation.InputText) ? "No text submitted." : Detail.Generation.InputText)</pre>
            @if (Detail.Generation.ImageContentType is not null)
            {
                <a href="@($"/ai-generations/{Detail.Generation.Id}/image")" target="_blank" rel="noopener">Open original screenshot</a>
                <img class="generation-screenshot" src="@($"/ai-generations/{Detail.Generation.Id}/image")" alt="Original screenshot submitted for session extraction" />
            }
        </section>
        <section>
            <RadzenHeading Size="H3" Text="Generated result" />
            <p>The initial result, before user edits.</p>
            @if (Rows.Count > 0)
            {
                <RadzenDataGrid Data="@Rows" TItem="ResultRow" AllowPaging="false">
                    <Columns>
                        <RadzenDataGridColumn TItem="ResultRow" Property="Title" Title="Game" />
                        <RadzenDataGridColumn TItem="ResultRow" Property="Date" Title="Date" />
                        <RadzenDataGridColumn TItem="ResultRow" Property="DurationMinutes" Title="Minutes" />
                        <RadzenDataGridColumn TItem="ResultRow" Property="PlatformKey" Title="Platform" />
                    </Columns>
                </RadzenDataGrid>
            }
            @if (Detail.Generation.ResultJson is null)
            {
                <p>No batch was generated.</p>
            }
            else
            {
                <details class="generation-response"><summary>Full initial result</summary><pre class="generation-text">@Pretty(Detail.Generation.ResultJson)</pre></details>
            }
        </section>
    </div>
    <RadzenHeading Size="H3" Text="Provider responses" />
    @if (Responses.Count == 0)
    {
        <p>No response body was received.</p>
    }
    @for (var i = 0; i < Responses.Count; i++)
    {
        var response = Responses[i];
        <details class="generation-response">
            <summary>Attempt @(i + 1) · HTTP @response.HttpStatus @(response.Truncated ? " · Response truncated at 1 MiB" : "")</summary>
            <pre class="generation-text">@Pretty(response.Body)</pre>
        </details>
    }
</RadzenCard>

@code {
    [Parameter, EditorRequired] public GenerationDetail Detail { get; set; } = null!;
    private IReadOnlyList<ResponseBody> Responses { get; set; } = [];
    private IReadOnlyList<ResultRow> Rows { get; set; } = [];
    private sealed record ResponseBody(int HttpStatus, string Body, bool Truncated);
    public sealed record ResultRow(string Title, string? Date, int? DurationMinutes, string PlatformKey);
    private sealed record ResultSnapshot(IReadOnlyList<ResultRow> Rows);

    protected override void OnParametersSet()
    {
        try { Responses = JsonSerializer.Deserialize<List<ResponseBody>>(Detail.Generation.ResponsesJson) ?? []; }
        catch (JsonException) { Responses = []; }
        try { Rows = Detail.Generation.ResultJson is null ? [] : JsonSerializer.Deserialize<ResultSnapshot>(Detail.Generation.ResultJson)?.Rows ?? []; }
        catch (JsonException) { Rows = []; }
    }

    private static string Pretty(string json)
    {
        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException) { return json; }
    }
}
