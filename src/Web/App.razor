@using Web.Infrastructure.Auth
@using Web.Routing
@inject AuthSession AuthSession
@inject NavigationManager Navigation

<CascadingValue Value="@_homeSession">
    <Router AppAssembly="@typeof(App).Assembly" OnNavigateAsync="HandleNavigationAsync">
        <Found Context="routeData">
            @if (_currentDecision.Outcome == NavigationOutcome.Render)
            {
                <CascadingValue TValue="string"
                                Name="NormalizedGameHash"
                                Value="@(_currentDecision.GameHash!)">
                    <RouteView RouteData="@routeData" />
                </CascadingValue>
            }
            else if (_currentDecision.Outcome == NavigationOutcome.HomeFallback)
            {
                <Home />
            }
        </Found>
        <NotFound>
            @if (_currentDecision.Outcome is NavigationOutcome.Render or NavigationOutcome.HomeFallback)
            {
                <Home />
            }
        </NotFound>
    </Router>
</CascadingValue>

@code {
    private Task? _initializationTask;
    private NavigationDecision _currentDecision = new(NavigationOutcome.Wait);
    private HomeSessionState _homeSession = new(false, null);
    private bool _isLoggedIn;

    private async Task HandleNavigationAsync(NavigationContext context)
    {
        var cancellationToken = context.CancellationToken;
        _initializationTask ??= InitializeSessionAsync();
        await _initializationTask.WaitAsync(cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();

        var path = context.Path;
        var separator = path.IndexOfAny('?', '#');
        if (separator >= 0) path = path[..separator];
        if (!path.StartsWith('/')) path = $"/{path}";

        var decision = NavigationGuard.Resolve(path, _isLoggedIn);

        cancellationToken.ThrowIfCancellationRequested();
        _currentDecision = decision;
        if (decision.Outcome == NavigationOutcome.Redirect && decision.RedirectPath is not null)
        {
            var current = new Uri(Navigation.Uri).PathAndQuery;
            var instruction = NavigationGuard.PlanNavigation(
                current,
                decision.RedirectPath,
                replaceHistory: true);
            cancellationToken.ThrowIfCancellationRequested();
            Navigation.NavigateTo(instruction.Target!, replace: instruction.ReplaceHistory);
        }
    }

    private async Task InitializeSessionAsync()
    {
        _isLoggedIn = await AuthSession.IsLoggedInAsync();
        _homeSession = new HomeSessionState(_isLoggedIn, await AuthSession.GetEmailAsync());
    }
}
