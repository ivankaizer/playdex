@using Microsoft.AspNetCore.Components
@using Web.Infrastructure.Auth
@using Web.Infrastructure.Browser
@using Web.Infrastructure.Components
@using Web.Routing
@inject AuthSession AuthSession
@inject BrowserInterop Browser
@inject IBrowserStorage Storage
@inject NavigationManager Navigation
@inject PlaydexApiClient Api

<main class="relative min-h-screen overflow-hidden bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-100">
    <Background />
    <div class="relative mx-auto w-full max-w-6xl p-3 sm:px-6 sm:py-12">
        <AppHeader Title="@Title"
                   NavItems="@NavItems"
                   Path="@CurrentPath"
                   OnNavigate="NavigateAsync"
                   OnLogout="LogoutAsync"
                   Theme="@_theme"
                   OnToggleTheme="ToggleThemeAsync"
                   SearchAsync="SearchGamesAsync" />

        @ChildContent
        <AppFooter />
    </div>
    @Overlay
</main>

@code {
    private const string ThemeKey = "playdex.theme";

    private static readonly IReadOnlyList<(string Label, string Path)> NavItems =
    [
        ("Dashboard", "/dashboard"),
        ("Sessions", "/sessions"),
        ("Recap", "/recap"),
        ("Mapping", "/mapping"),
        ("Settings", "/settings"),
    ];

    private string _theme = "light";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Overlay { get; set; }

    [Parameter]
    public EventCallback<string> OnThemeChanged { get; set; }

    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;

    protected override async Task OnInitializedAsync()
    {
        var savedTheme = await Storage.GetAsync(ThemeKey);
        _theme = savedTheme is "light" or "dark"
            ? savedTheme
            : await Browser.PrefersDarkAsync() ? "dark" : "light";
        await ApplyThemeAsync();
        await OnThemeChanged.InvokeAsync(_theme);
    }

    private async Task ToggleThemeAsync()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        await ApplyThemeAsync();
        await OnThemeChanged.InvokeAsync(_theme);
    }

    private async Task ApplyThemeAsync()
    {
        await Browser.ApplyThemeAsync(_theme);
        await Storage.SetAsync(ThemeKey, _theme);
    }

    private async Task NavigateAsync(string target)
    {
        var instruction = NavigationGuard.PlanNavigation(
            new Uri(Navigation.Uri).PathAndQuery,
            target,
            replaceHistory: false);
        if (instruction.Kind == NavigationInstructionKind.NoOp) return;

        Navigation.NavigateTo(instruction.Target!);
        if (instruction.ScrollToTop) await Browser.ScrollToTopAsync();
    }

    private Task<GameSearchResponse> SearchGamesAsync(string path, CancellationToken cancellationToken) =>
        Api.SendAsync<GameSearchResponse>(path, cancellationToken: cancellationToken);

    private async Task LogoutAsync()
    {
        await AuthSession.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
