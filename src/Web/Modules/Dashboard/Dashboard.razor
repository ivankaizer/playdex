@page "/dashboard"
@using Web.Infrastructure.Components
@using Web.Layout

@{
    var currentSession = CurrentSession;
    var todaySessionCards = TodaySessionCards;
    var todayPlatforms = TodayPlatforms;
}

<AppLayout Title="Dashboard" OnThemeChanged="SetTheme">
    <ChildContent>
        <section class="mt-10 space-y-6">
            <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 px-4 py-3 sm:px-6 sm:py-4">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                        Current session
                    </p>
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="rounded-full border border-emerald-400/40 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-200">
                            @(currentSession is null ? "Idle" : "Live")
                        </span>
                    </div>
                </div>
                @if (_state.IsDashboardLoading)
                {
                    <div class="mt-3 flex flex-wrap items-center justify-between gap-5">
                        <div class="h-6 w-40 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                        <div class="flex flex-wrap items-center justify-end gap-4">
                            <div class="h-3 w-24 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                            <div class="h-3 w-32 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                            <div class="h-3 w-28 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mt-3 flex flex-wrap items-center justify-between gap-5 text-sm font-semibold text-slate-600 dark:text-slate-300">
                        @if (currentSession is not null)
                        {
                            <button type="button"
                                    @onclick="() => NavigateToGameAsync(currentSession.GameId)"
                                    class="text-left text-lg font-semibold text-slate-900 dark:text-white transition hover:text-emerald-700 dark:hover:text-emerald-200">
                                @currentSession.Title
                            </button>
                            <div class="flex flex-wrap items-center justify-end gap-4 text-sm font-semibold normal-case tracking-normal text-slate-600 dark:text-slate-300">
                                <span class="inline-flex items-center gap-2 text-slate-700 dark:text-slate-200">
                                    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3.5 w-3.5 text-emerald-700 dark:text-emerald-300" fill="currentColor">
                                        <path d="M3 5a2 2 0 012-2h10a2 2 0 012 2v2H3V5zm0 4h14v6a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                                    </svg>
                                    @currentSession.Platform
                                </span>
                                <span class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-300">
                                    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3.5 w-3.5 text-slate-500 dark:text-slate-400" fill="currentColor">
                                        <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 4v4.59l3.3 3.3-1.42 1.42L9 11V6h2z"></path>
                                    </svg>
                                    Started @currentSession.StartedAt
                                </span>
                                <span class="inline-flex items-center gap-2 text-emerald-700 dark:text-emerald-200">
                                    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3.5 w-3.5 text-emerald-700 dark:text-emerald-300" fill="currentColor">
                                        <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm-1 3h2v6h4v2H9V5z"></path>
                                    </svg>
                                    Elapsed @currentSession.Elapsed
                                </span>
                                @if (currentSession.CanStop)
                                {
                                    <button type="button"
                                            disabled="@_isStoppingManualSession"
                                            @onclick="StopManualSessionAsync"
                                            class="rounded-full border border-rose-500/60 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-rose-700 transition hover:border-rose-400 hover:bg-rose-50 disabled:cursor-not-allowed disabled:opacity-60 dark:text-rose-200 dark:hover:bg-rose-950/40">
                                        @(_isStoppingManualSession ? "Stopping..." : "Stop session")
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <h2 class="text-sm font-semibold text-slate-700 dark:text-slate-200">
                                No session running right now.
                            </h2>
                        }
                    </div>
                    @if (_manualActionError.Length > 0)
                    {
                        <p role="alert" class="mt-3 text-sm text-rose-700 dark:text-rose-300">@_manualActionError</p>
                    }
                }
            </div>

            <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
                <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                                Today stats
                            </p>
                            <h2 class="text-xl font-semibold text-slate-900 dark:text-white">
                                @_state.TodayHours played
                            </h2>
                        </div>
                        <button type="button"
                                @onclick="NavigateToTodayRecapAsync"
                                class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 text-slate-600 dark:text-slate-200 transition hover:border-emerald-300 hover:text-emerald-700 dark:hover:text-emerald-200"
                                aria-label="Open recap"
                                title="Open recap">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-column h-4 w-4" aria-hidden="true">
                                <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
                                <path d="M18 17V9"></path>
                                <path d="M13 17V5"></path>
                                <path d="M8 17v-3"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="mt-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
                        <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                            Platform distribution
                        </p>
                        @if (todayPlatforms.Count == 0)
                        {
                            <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
                                No sessions logged today yet.
                            </p>
                        }
                        else
                        {
                            <div class="mt-4 flex flex-wrap items-center gap-4">
                                <StatsPieChart Segments="@TodayPieSegments" Colors="@PlatformPieColors" Size="140" />
                                <div class="flex-1 space-y-2 text-xs text-slate-600 dark:text-slate-300">
                                    @for (var index = 0; index < todayPlatforms.Count; index++)
                                    {
                                        var item = todayPlatforms[index];
                                        <div class="flex items-center justify-between gap-3">
                                            <div class="flex items-center gap-2">
                                                <span class="h-2 w-2 rounded-full" style="@($"background-color: {PlatformPieColors[index % PlatformPieColors.Count]}")"></span>
                                                <span>@item.Label</span>
                                            </div>
                                            <span>@item.Value% · @item.Hours</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                                Today sessions
                            </p>
                            <h2 class="text-xl font-semibold text-slate-900 dark:text-white">
                                @todaySessionCards.Count @(todaySessionCards.Count == 1 ? "session" : "sessions") logged
                            </h2>
                        </div>
                        <button type="button"
                                @onclick="NavigateToSessionsAsync"
                                class="rounded-full border border-slate-300 dark:border-slate-700 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-slate-700 dark:text-slate-200 transition hover:border-emerald-400/60">
                            View all
                        </button>
                    </div>
                    <div class="mt-5 space-y-4">
                        @if (_state.DashboardError.Length > 0)
                        {
                            <div class="rounded-2xl border border-rose-500/30 bg-rose-500/10 p-4 text-xs text-rose-700 dark:text-rose-200">
                                @_state.DashboardError
                            </div>
                        }
                        else if (_state.IsDashboardLoading)
                        {
                            @foreach (var item in new[] { 1, 2, 3 })
                            {
                                <div @key="item" class="flex items-center justify-between gap-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
                                    <div class="flex items-center gap-3">
                                        <div class="h-14 w-10 rounded-xl bg-slate-200/70 dark:bg-slate-800/60"></div>
                                        <div class="space-y-2">
                                            <div class="h-3 w-28 rounded-full bg-slate-200/70 dark:bg-slate-800/70"></div>
                                            <div class="h-2 w-16 rounded-full bg-slate-200/50 dark:bg-slate-800/50"></div>
                                        </div>
                                    </div>
                                    <div class="h-3 w-12 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                                </div>
                            }
                        }
                        else if (todaySessionCards.Count == 0)
                        {
                            <div class="rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 bg-slate-200/40 dark:bg-slate-950/40 p-4 text-xs text-slate-500 dark:text-slate-400">
                                No sessions logged today yet.
                            </div>
                        }
                        else
                        {
                            @foreach (var session in _state.TodaySessionPageItems)
                            {
                                <div @key="session.SessionId"
                                     class="relative flex flex-wrap items-center justify-between gap-4 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4"
                                     style="@(session.ImageUrl is null ? null : $"background-image: url({session.ImageUrl}); background-size: cover; background-position: center")">
                                    <div class="@($"absolute inset-0 {(session.ImageUrl is null ? "bg-white/90 dark:bg-slate-900/70" : "bg-white/90 dark:bg-slate-950/80")}")"></div>
                                    <div class="relative z-10 flex items-center gap-3">
                                        @if (session.ImageUrl is null)
                                        {
                                            <div class="h-14 w-10 rounded-xl bg-slate-200/70 dark:bg-slate-800/60"></div>
                                        }
                                        <button type="button"
                                                @onclick="() => NavigateToGameAsync(session.GameId)"
                                                class="text-left text-sm font-semibold text-slate-900 dark:text-white transition hover:text-emerald-700 dark:hover:text-emerald-200">
                                            @session.Title
                                        </button>
                                    </div>
                                    <div class="relative z-10 flex items-center gap-4">
                                        <p class="text-xs text-slate-500 dark:text-slate-400">
                                            @session.Platform
                                        </p>
                                        <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-200">
                                            @session.Duration
                                        </p>
                                    </div>
                                </div>
                            }

                            @if (_state.TodaySessionsTotalPages > 1)
                            {
                                <div class="flex items-center justify-between pt-2 text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
                                    <button type="button"
                                            class="rounded-full border border-slate-200 dark:border-slate-800 px-3 py-1.5 text-slate-700 dark:text-slate-200 transition hover:border-emerald-400/60 hover:text-emerald-700 dark:hover:text-emerald-200 disabled:cursor-not-allowed disabled:opacity-50"
                                            @onclick="() => _state.SetTodaySessionsPage(_state.TodaySessionsPage - 1)"
                                            disabled="@(_state.TodaySessionsPage == 1)">
                                        Prev
                                    </button>
                                    <span>@_state.TodaySessionsPage of @_state.TodaySessionsTotalPages</span>
                                    <button type="button"
                                            class="rounded-full border border-slate-200 dark:border-slate-800 px-3 py-1.5 text-slate-700 dark:text-slate-200 transition hover:border-emerald-400/60 hover:text-emerald-700 dark:hover:text-emerald-200 disabled:cursor-not-allowed disabled:opacity-50"
                                            @onclick="() => _state.SetTodaySessionsPage(_state.TodaySessionsPage + 1)"
                                            disabled="@(_state.TodaySessionsPage == _state.TodaySessionsTotalPages)">
                                        Next
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <StatsRecapSection Title="Monthly stats"
                               Subtitle="@MonthlyHighlightsLabel"
                               Summary="@MonthlySummary"
                               Platforms="@MonthlyPlatforms"
                               TopGames="@MonthlyTopGames"
                               Colors="@PlatformPieColors"
                               OnGameSelect="NavigateToGameAsync"
                               OnOpenRecap="NavigateToMonthlyRecapAsync" />

            <StatsRecapSection Title="Yearly stats"
                               Subtitle="@YearlyRecapLabel"
                               Summary="@YearlySummary"
                               Platforms="@YearlyPlatforms"
                               TopGames="@YearlyTopGames"
                               Colors="@PlatformPieColors"
                               OnGameSelect="NavigateToGameAsync"
                               OnOpenRecap="NavigateToYearlyRecapAsync" />
        </section>
    </ChildContent>
</AppLayout>
