@page "/settings"
@using Web.Layout

<AppLayout Title="Settings">
    <div class="mt-10 space-y-8">
        <section data-settings-section="preferences"
                 class="rounded-3xl border border-slate-200 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/60 sm:p-6">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                    Your preferences
                </p>
                <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">
                    Personal settings
                </h2>
                <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
                    Tune how Playdex records short sessions and reaches you.
                </p>
            </div>

            <div class="mt-6 grid gap-5 lg:grid-cols-2">
                <div data-settings-group="sessions"
                     class="rounded-2xl border border-slate-200 bg-slate-100/60 p-4 dark:border-slate-800 dark:bg-slate-950/50 sm:p-5">
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Session filtering</h3>
                    <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">
                        Sessions shorter than this duration are marked ignored and excluded from stats. Set to 0 to disable.
                    </p>
                    <label class="mt-5 block max-w-48 text-xs font-medium text-slate-600 dark:text-slate-300">
                        <span class="block">Minimum minutes</span>
                        <input type="number"
                               min="0"
                               step="1"
                               inputmode="numeric"
                               value="@_state.IgnoreShortSessionsMinutes"
                               @oninput="ChangeIgnoreShortSessionsMinutes"
                               disabled="@(_state.IsSettingsLoading || _state.IsSettingsSaving || _state.IsTestNotificationSending)"
                               class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
                    </label>
                </div>

                <div data-settings-group="telegram"
                     class="rounded-2xl border border-slate-200 bg-slate-100/60 p-4 dark:border-slate-800 dark:bg-slate-950/50 sm:p-5">
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Telegram notifications</h3>
                    <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">
                        Message the Playdex bot once, then save your chat ID. Leave it blank to disable notifications.
                    </p>
                    <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-end">
                        <label class="min-w-0 flex-1 text-xs font-medium text-slate-600 dark:text-slate-300">
                            <span class="block">Chat ID</span>
                            <input type="text"
                                   inputmode="numeric"
                                   placeholder="123456789"
                                   value="@_state.TelegramChatId"
                                   @oninput="ChangeTelegramChatId"
                                   disabled="@(_state.IsSettingsLoading || _state.IsSettingsSaving || _state.IsTestNotificationSending)"
                                   class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
                        </label>
                        <button type="button"
                                @onclick="SendTestNotificationAsync"
                                disabled="@(!_state.CanSendTestNotification)"
                                class="shrink-0 rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-emerald-400 hover:text-emerald-700 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-700 dark:text-slate-200 dark:hover:text-emerald-200">
                            @(_state.IsTestNotificationSending ? "Sending..." : "Send test")
                        </button>
                    </div>
                </div>
            </div>

            <div class="mt-5 flex flex-col gap-4 border-t border-slate-200 pt-5 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-h-10 flex-1" aria-live="polite">
                    @if (!string.IsNullOrEmpty(_state.SettingsError))
                    {
                        <p class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2.5 text-xs text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300">
                            @_state.SettingsError
                        </p>
                    }
                    else if (!string.IsNullOrEmpty(_state.TestNotificationMessage))
                    {
                        <p class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-300">
                            @_state.TestNotificationMessage
                        </p>
                    }
                    else if (!string.IsNullOrEmpty(_state.TestNotificationError))
                    {
                        <p class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2.5 text-xs text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300">
                            @_state.TestNotificationError
                        </p>
                    }
                </div>
                <button type="button"
                        @onclick="SaveSettingsAsync"
                        disabled="@(_state.IsSettingsLoading || _state.IsSettingsSaving || _state.IsTestNotificationSending)"
                        class="shrink-0 rounded-xl bg-emerald-400 px-4 py-2.5 text-sm font-semibold text-slate-900 transition hover:bg-emerald-300 disabled:cursor-not-allowed disabled:bg-emerald-300/60">
                    @(_state.IsSettingsSaving ? "Saving..." : _state.IsSettingsLoading ? "Loading..." : "Save changes")
                </button>
            </div>
        </section>

        <section data-settings-section="integrations"
                 class="rounded-3xl border border-slate-200 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/60 sm:p-6">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                    Integrations
                </p>
                <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">
                    Connected services
                </h2>
                <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
                    Manage the services that contribute activity to Playdex.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(_state.ProvidersError))
            {
                <p class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2.5 text-xs text-rose-700 dark:border-rose-900/60 dark:bg-rose-950/30 dark:text-rose-300">
                    @_state.ProvidersError
                </p>
            }

            <div class="mt-6 space-y-3">
                @if (_state.IsProvidersLoading)
                {
                    @for (var item = 1; item <= 2; item++)
                    {
                        <div @key="item" class="flex items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-100/60 p-4 dark:border-slate-800 dark:bg-slate-950/50">
                            <div class="flex items-center gap-3">
                                <div class="h-10 w-10 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                                <div class="space-y-2">
                                    <div class="h-3 w-24 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                                    <div class="h-2 w-16 rounded-full bg-slate-200/50 dark:bg-slate-800/50"></div>
                                </div>
                            </div>
                            <div class="h-8 w-24 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                        </div>
                    }
                }
                else if (_state.VisibleProviders.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-100/50 p-4 text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-950/40 dark:text-slate-400">
                        No integrations connected yet. Add one to start syncing playtime.
                    </div>
                }
                else
                {
                    @foreach (var provider in _state.VisibleProviders)
                    {
                        var presentation = SettingsState.Present(provider);
                        var isUpdating = _state.IsProviderUpdating(provider.Id);
                        var isProviderMutationInProgress = _state.IsProviderMutationInProgress(provider.Id);
                        var isProviderActionBlocked = _state.IsProviderActionBlocked(provider.Id);
                        <article @key="provider.Id"
                                 class="rounded-2xl border border-slate-200 bg-slate-100/60 p-4 dark:border-slate-800 dark:bg-slate-950/50 sm:p-5">
                            <div class="flex flex-wrap items-center justify-between gap-4">
                                <div class="flex min-w-0 items-center gap-3">
                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full @presentation.Color">
                                        <span class="text-xs font-semibold uppercase @presentation.Accent">
                                            @presentation.Label
                                        </span>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-sm font-semibold text-slate-900 dark:text-white">
                                            @presentation.Name
                                        </p>
                                        <p class="truncate text-xs text-slate-500 dark:text-slate-400">
                                            @presentation.Subtitle
                                        </p>
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center gap-2 text-xs">
                                    <span data-integration-status="@provider.Status"
                                          class="@IntegrationStatusClass(provider)">
                                        @(isUpdating ? "Updating..." : provider.Status == "active" ? "Active" : "Paused")
                                    </span>
                                    <button type="button"
                                            @onclick="() => ToggleCredentialEditorAsync(provider)"
                                            disabled="@(_state.IsAnySessionPlatformSaving || isProviderMutationInProgress)"
                                            class="rounded-full border border-slate-300 px-3 py-2 font-semibold uppercase tracking-[0.2em] text-slate-700 transition hover:border-emerald-400/60 hover:text-emerald-700 dark:border-slate-700 dark:text-slate-200 dark:hover:text-emerald-100">
                                        @(_state.IsEditingCredential(provider.Id) ? "Close" : "Manage")
                                    </button>
                                </div>
                            </div>

                            @if (provider.Platform == "api" && !string.IsNullOrEmpty(provider.ApiKey))
                            {
                                <div data-playdex-app-setup class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50/70 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/20">
                                    <p class="text-sm font-semibold text-slate-900 dark:text-white">Set up Playdex for Windows</p>
                                    <p class="mt-1 text-xs text-slate-600 dark:text-slate-300">
                                        The Playdex app records the games you play on your PC. Download and run
                                        <a href="https://github.com/ivankaizer/playdex/releases/latest" target="_blank" rel="noreferrer" class="font-semibold text-emerald-700 underline dark:text-emerald-300">Playdex-Setup.exe</a>,
                                        and enter these two values when it asks (they are also in the app under Settings → Your Playdex account).
                                    </p>
                                    <div class="mt-3 grid gap-3 sm:grid-cols-2">
                                        <div class="text-xs font-medium text-slate-600 dark:text-slate-300">
                                            <span class="block">Playdex server (API URL)</span>
                                            <div class="mt-2 flex gap-2">
                                                <input type="text" value="@Api.ApiBaseUrl" readonly aria-readonly="true" aria-label="Playdex server"
                                                       class="min-w-0 flex-1 rounded-xl border border-slate-300 bg-white/90 px-3 py-2 font-mono text-sm text-slate-900 outline-none dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
                                                <button type="button" @onclick='() => CopyAsync("server", Api.ApiBaseUrl)'
                                                        class="shrink-0 rounded-full border border-slate-300 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-700 transition hover:border-emerald-400 dark:border-slate-700 dark:text-slate-200">
                                                    @(_copied == "server" ? "Copied" : "Copy")
                                                </button>
                                            </div>
                                        </div>
                                        <div class="text-xs font-medium text-slate-600 dark:text-slate-300">
                                            <span class="block">API key</span>
                                            <div class="mt-2 flex gap-2">
                                                <input type="password" value="@provider.ApiKey" readonly aria-readonly="true" aria-label="API key" autocomplete="off"
                                                       class="min-w-0 flex-1 rounded-xl border border-slate-300 bg-white/90 px-3 py-2 font-mono text-sm text-slate-900 outline-none dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
                                                <button type="button" @onclick='() => CopyAsync("key", provider.ApiKey!)'
                                                        class="shrink-0 rounded-full border border-slate-300 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-700 transition hover:border-emerald-400 dark:border-slate-700 dark:text-slate-200">
                                                    @(_copied == "key" ? "Copied" : "Copy")
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (_state.IsEditingCredential(provider.Id))
                            {
                                <div class="mt-5 border-t border-slate-200 pt-5 dark:border-slate-800">
                                    <div class="grid gap-3 sm:grid-cols-2">
                                        <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                                            <span class="block">Account ID</span>
                                            <input type="text"
                                                   value="@_state.EditingAccountId"
                                                   @oninput="ChangeEditingAccountId"
                                                   disabled="@_state.IsCredentialSaving(provider.Id)"
                                                   class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
                                        </label>
                                        @if (provider.Platform == "api")
                                        {
                                            <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                                                <span class="block">API key</span>
                                                <input type="text"
                                                       value="@_state.EditingApiKey"
                                                       readonly
                                                       aria-readonly="true"
                                                       class="mt-2 w-full cursor-text rounded-xl border border-slate-300 bg-slate-200/40 px-3 py-2 font-mono text-sm text-slate-700 outline-none dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-300" />
                                                <span class="mt-1 block font-normal text-slate-500 dark:text-slate-400">Generated locally and read-only.</span>
                                            </label>
                                        }
                                        else if (provider.ApiKeyLocked)
                                        {
                                            <div class="text-xs font-medium text-slate-600 dark:text-slate-300">
                                                <span class="block">API key</span>
                                                <div class="mt-2 flex items-center gap-2 rounded-xl border border-slate-300 bg-slate-200/40 px-3 py-2 text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-400">
                                                    <span class="inline-flex h-2 w-2 rounded-full bg-amber-400"></span>
                                                    Managed by administrator
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                                                <span class="block">API key</span>
                                                <input type="text"
                                                       value="@_state.EditingApiKey"
                                                       @oninput="ChangeEditingApiKey"
                                                       disabled="@_state.IsCredentialSaving(provider.Id)"
                                                       class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
                                            </label>
                                        }
                                    </div>

                                    @if (provider.SessionPlatform is not null &&
                                         provider.SessionPlatformOptions is { Count: > 0 })
                                    {
                                        var isSessionPlatformSaving = _state.IsSessionPlatformSaving(provider.Id);
                                        <div class="mt-4 rounded-xl border border-slate-200 bg-white/60 p-3 dark:border-slate-800 dark:bg-slate-900/50">
                                            <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                                                <span class="block">Recording platform</span>
                                                <select value="@_state.GetSelectedSessionPlatformKey(provider)"
                                                        @onchange="eventArgs => ChangeSessionPlatform(provider, eventArgs)"
                                                        disabled="@isProviderMutationInProgress"
                                                        class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white">
                                                    @foreach (var option in provider.SessionPlatformOptions)
                                                    {
                                                        <option value="@option.Key">@option.Name</option>
                                                    }
                                                </select>
                                                <span class="mt-1 block font-normal text-slate-500 dark:text-slate-400">
                                                    New sessions recorded by this integration use this platform.
                                                </span>
                                            </label>

                                            @if (_state.PendingSessionPlatformProviderId == provider.Id)
                                            {
                                                <div role="alertdialog" aria-label="Confirm recording platform change" class="mt-3 border-t border-slate-200 pt-3 dark:border-slate-800">
                                                    <p class="text-xs text-slate-600 dark:text-slate-300">
                                                        Should existing sessions from this integration also use the new platform?
                                                    </p>
                                                    <div class="mt-3 flex flex-wrap gap-2">
                                                        <button type="button"
                                                                @onclick="() => SaveSessionPlatformAsync(provider, true)"
                                                                disabled="@isSessionPlatformSaving"
                                                                class="rounded-full bg-emerald-400 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-900 disabled:cursor-not-allowed disabled:opacity-60">
                                                            Future and existing sessions
                                                        </button>
                                                        <button type="button"
                                                                @onclick="() => SaveSessionPlatformAsync(provider, false)"
                                                                disabled="@isSessionPlatformSaving"
                                                                class="rounded-full border border-slate-300 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-700 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-200">
                                                            Future sessions only
                                                        </button>
                                                        <button type="button"
                                                                @onclick="CancelSessionPlatformChange"
                                                                disabled="@isSessionPlatformSaving"
                                                                class="px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500 disabled:cursor-not-allowed disabled:opacity-60 dark:text-slate-400">
                                                            Cancel
                                                        </button>
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(_state.SessionPlatformError))
                                            {
                                                <p class="mt-3 text-xs text-rose-700 dark:text-rose-300">@_state.SessionPlatformError</p>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(_state.CredentialError))
                                    {
                                        <p class="mt-3 text-xs text-rose-700 dark:text-rose-300">@_state.CredentialError</p>
                                    }

                                    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                                        <button type="button"
                                                @onclick="() => ToggleProviderAsync(provider)"
                                                disabled="@isProviderActionBlocked"
                                                class="@IntegrationActionButtonClass(provider)">
                                            @(isUpdating ? "Updating..." : provider.Status == "active" ? "Pause" : "Resume")
                                        </button>
                                        <button type="button"
                                                @onclick="() => SaveCredentialAsync(provider)"
                                                disabled="@isProviderActionBlocked"
                                                class="rounded-full bg-emerald-400 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-900 transition hover:bg-emerald-300 disabled:cursor-not-allowed disabled:bg-emerald-300/60">
                                            @(_state.IsCredentialSaving(provider.Id) ? "Saving..." : "Save credentials")
                                        </button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                }
            </div>

            @if (!_state.IsProvidersLoading && _state.AvailableIntegrationPlatforms.Count > 0)
            {
                <div data-integration-creator
                     class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-100/40 p-4 dark:border-slate-700 dark:bg-slate-950/30 sm:p-5">
                    @if (!_state.IsIntegrationCreatorOpen)
                    {
                        <button type="button"
                                @onclick="OpenIntegrationCreator"
                                class="flex w-full items-center justify-between gap-4 text-left">
                            <span>
                                <span class="block text-sm font-semibold text-slate-900 dark:text-white">Add integration</span>
                                <span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">Connect up to 3 accounts per service.</span>
                            </span>
                            <span aria-hidden="true" class="text-xl text-emerald-600 dark:text-emerald-300">+</span>
                        </button>
                    }
                    else if (_state.SelectedCreationPlatform is null)
                    {
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <p class="text-sm font-semibold text-slate-900 dark:text-white">Choose an integration</p>
                                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">You can connect up to 3 accounts per service.</p>
                            </div>
                            <button type="button" @onclick="CancelIntegrationCreation" class="text-xs font-semibold text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Cancel</button>
                        </div>
                        <div class="mt-4 grid gap-3 sm:grid-cols-3">
                            @if (_state.AvailableIntegrationPlatforms.Contains("steam"))
                            {
                                <button type="button" @onclick='() => SelectCreationPlatform("steam")' class="rounded-xl border border-slate-300 bg-white/80 px-4 py-3 text-left text-sm font-semibold text-slate-900 transition hover:border-emerald-400 dark:border-slate-700 dark:bg-slate-900/70 dark:text-white">Steam</button>
                            }
                            @if (_state.AvailableIntegrationPlatforms.Contains("psn"))
                            {
                                <button type="button" @onclick='() => SelectCreationPlatform("psn")' class="rounded-xl border border-slate-300 bg-white/80 px-4 py-3 text-left text-sm font-semibold text-slate-900 transition hover:border-emerald-400 dark:border-slate-700 dark:bg-slate-900/70 dark:text-white">PlayStation</button>
                            }
                            @if (_state.AvailableIntegrationPlatforms.Contains("xbox"))
                            {
                                <button type="button" @onclick='() => SelectCreationPlatform("xbox")' class="rounded-xl border border-slate-300 bg-white/80 px-4 py-3 text-left text-sm font-semibold text-slate-900 transition hover:border-emerald-400 dark:border-slate-700 dark:bg-slate-900/70 dark:text-white">Xbox</button>
                            }
                        </div>
                    }
                    else
                    {
                        var platform = _state.SelectedCreationPlatform;
                        <div>
                            <p class="text-sm font-semibold text-slate-900 dark:text-white">Connect @SettingsState.CreationPlatformName(platform)</p>
                            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Enter the credentials Playdex needs to sync this account.</p>
                        </div>

                        <div class="mt-5 grid gap-3 sm:grid-cols-2">
                            <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                                <span class="block">@(platform == "steam" ? "Steam Web API key" : platform == "psn" ? "NPSSO token" : "OpenXBL API key")</span>
                                <input type="password"
                                       value="@_state.CreationApiKey"
                                       @oninput="ChangeCreationApiKey"
                                       disabled="@_state.IsCreatingIntegration"
                                       autocomplete="off"
                                       class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
                            </label>
                            <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                                <span class="block">
                                    @(platform == "steam" ? "Steam ID" : platform == "psn" ? "Account ID" : "Xbox XUID")
                                    @if (platform != "steam")
                                    {
                                        <span class="font-normal text-slate-400"> (optional)</span>
                                    }
                                </span>
                                <input type="text"
                                       value="@_state.CreationAccountId"
                                       @oninput="ChangeCreationAccountId"
                                       disabled="@_state.IsCreatingIntegration"
                                       inputmode="@(platform == "xbox" ? "numeric" : null)"
                                       class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
                            </label>
                        </div>
                        @if (platform == "xbox")
                        {
                            <p class="mt-3 text-[11px] text-slate-500 dark:text-slate-400">
                                Leave XUID empty to use the Xbox account linked to the key. Get a key from
                                <a href="https://xbl.io/dashboard" target="_blank" rel="noreferrer" class="font-semibold text-emerald-700 underline dark:text-emerald-300">OpenXBL</a>.
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(_state.CreationError))
                        {
                            <p class="mt-3 text-xs text-rose-700 dark:text-rose-300">@_state.CreationError</p>
                        }
                        <div class="mt-4 flex flex-wrap justify-end gap-3">
                            <button type="button" @onclick="CancelIntegrationCreation" disabled="@_state.IsCreatingIntegration" class="rounded-full border border-slate-300 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-600 transition hover:border-slate-400 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-300">Cancel</button>
                            <button type="button" @onclick="CreateIntegrationAsync" disabled="@_state.IsCreatingIntegration" class="rounded-full bg-emerald-400 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-900 transition hover:bg-emerald-300 disabled:cursor-not-allowed disabled:opacity-60">
                                @(_state.IsCreatingIntegration ? "Connecting..." : $"Connect {SettingsState.CreationPlatformName(platform)}")
                            </button>
                        </div>
                    }
                </div>
            }
        </section>

        <Mapping />
    </div>
</AppLayout>
