@page "/sessions"
@using Web.Infrastructure.Components
@using Web.Layout

@{
    var rowViews = RowViews;
    var hasSessionFilters = HasSessionFilters;
}

<AppLayout Title="Sessions" OnThemeChanged="SetTheme">
    <ChildContent>
        <section data-session-heading-row class="mt-10 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                        Sessions log
                    </p>
                    <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">
                        Every session tracked
                    </h2>
                </div>
                <button type="button"
                        data-session-action="extended"
                        @onclick="OpenSessionCreator"
                        class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-slate-700 shadow-sm transition hover:border-emerald-400 hover:text-emerald-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:text-emerald-200">
                    <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7">
                        <path d="M4 4.75h12M4 10h12M4 15.25h7" stroke-linecap="round"></path>
                    </svg>
                    Session Creator
                </button>
            </div>
        </section>

        <LiveSessionControl Platforms="_state.Platforms"
                            ActiveSession="_state.ActiveManualSession"
                            Busy="_isStoppingManualSession"
                            Error="@_manualActionError"
                            SearchGamesAsync="SearchLiveGamesAsync"
                            OnStart="StartManualSessionAsync"
                            OnStop="StopManualSessionAsync" />

        <section data-session-history-row class="mt-5 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
            <div class="mt-6 flex flex-wrap gap-2">
                @foreach (var preset in Presets)
                {
                    <button @key="preset.Key"
                            type="button"
                            @onclick="() => SelectPresetAsync(preset.Key)"
                            class="@(preset.Key == _state.Preset
                                ? "rounded-full border px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] transition border-emerald-300 bg-emerald-400 text-slate-900"
                                : "rounded-full border px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] transition border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:border-emerald-300/70")">
                        @preset.Label
                    </button>
                }
            </div>

            <div class="mt-6 grid gap-3 md:grid-cols-2 xl:grid-cols-[1.2fr_0.8fr_0.6fr_0.6fr]">
                <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                    Title
                    <input type="text"
                           placeholder="Search by game title"
                           value="@_state.Title"
                           @oninput="HandleTitleChanged"
                           class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-3 py-2 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30" />
                </label>
                <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                    Platform
                    <select value="@_state.Platform"
                            @onchange="ChangePlatformAsync"
                            class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white">
                        <option value="">All platforms</option>
                        @foreach (var platform in StatsPlatforms)
                        {
                            <option @key="platform.Key" value="@platform.Key">@platform.Label</option>
                        }
                    </select>
                </label>
                <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                    From
                    <input type="date"
                           value="@_state.From"
                           @onchange="ChangeFromAsync"
                           class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-3 py-2 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30" />
                </label>
                <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                    To
                    <input type="date"
                           value="@_state.To"
                           @onchange="ChangeToAsync"
                           class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-3 py-2 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30" />
                </label>
            </div>

            @if (_state.ListError.Length > 0)
            {
                <p class="mt-4 text-xs text-rose-700 dark:text-rose-300">
                    @_state.ListError
                </p>
            }
            @if (_state.StatsError.Length > 0)
            {
                <p class="mt-4 text-xs text-rose-700 dark:text-rose-300">
                    @_state.StatsError
                </p>
            }

            <div class="mt-6">
                <StatsRecapSection Title="Sessions recap"
                                   Subtitle="@StatsRangeLabel"
                                   Summary="@StatsSummary"
                                   Platforms="@StatsPlatforms"
                                   TopGames="@StatsTopGames"
                                   Colors="@PieColors"
                                   SelectedPlatform="@_state.Platform"
                                   OnPlatformSelect="TogglePlatformAsync"
                                   OnGameSelect="NavigateToGameAsync"
                                   OnOpenRecap="OpenRecapAsync" />
                @if (_state.IsStatsLoading)
                {
                    <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
                        Loading stats...
                    </p>
                }
            </div>

            <div class="mt-6 rounded-3xl border border-slate-200 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/60 sm:p-6">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                            Monthly trend
                        </p>
                        <h3 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">
                            Hours per month
                        </h3>
                    </div>
                    @if (_state.Platform.Length > 0)
                    {
                        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-900 dark:bg-emerald-400/10 dark:text-emerald-100">
                            @StatsPlatforms.FirstOrDefault(item => item.Key == _state.Platform).Label
                        </span>
                    }
                </div>
                <div class="mt-6">
                    @if (_state.IsStatsLoading)
                    {
                        <div class="h-40 animate-pulse rounded-2xl bg-slate-200/70 dark:bg-slate-800/60"></div>
                    }
                    else
                    {
                        <StatsMonthlyHoursChart Months="@StatsMonths" />
                    }
                </div>
            </div>

            <div class="mt-6 space-y-3 md:hidden">
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 px-4 py-3 text-[11px] uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">
                    <span>Sort</span>
                    <div class="flex items-center gap-2">
                        <button type="button"
                                @onclick='() => SortAsync("date")'
                                class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 font-semibold transition hover:border-emerald-400/60 hover:text-emerald-700 dark:hover:text-emerald-100">
                            Date
                            <svg aria-hidden="true" viewBox="0 0 20 20" class='@($"h-3 w-3 {(_state.SortKey == "date" ? "text-emerald-700 dark:text-emerald-200" : "")}")' fill="currentColor">
                                <path d='@SortIconPath("date")'></path>
                            </svg>
                        </button>
                        <button type="button"
                                @onclick='() => SortAsync("duration")'
                                class="inline-flex items-center gap-2 rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 font-semibold transition hover:border-emerald-400/60 hover:text-emerald-700 dark:hover:text-emerald-100">
                            Duration
                            <svg aria-hidden="true" viewBox="0 0 20 20" class='@($"h-3 w-3 {(_state.SortKey == "duration" ? "text-emerald-700 dark:text-emerald-200" : "")}")' fill="currentColor">
                                <path d='@SortIconPath("duration")'></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="grid gap-3">
                    @if (_state.IsListLoading)
                    {
                        @foreach (var row in new[] { 1, 2, 3, 4 })
                        {
                            <div @key="row" class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 p-4">
                                <div class="flex items-start gap-3">
                                    <div class="h-14 w-10 rounded-xl bg-slate-200/70 dark:bg-slate-800/60"></div>
                                    <div class="flex-1 space-y-2">
                                        <div class="h-3 w-32 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                                        <div class="h-3 w-20 rounded-full bg-slate-200/50 dark:bg-slate-800/50"></div>
                                        <div class="h-3 w-16 rounded-full bg-slate-200/50 dark:bg-slate-800/50"></div>
                                    </div>
                                    <div class="h-3 w-12 rounded-full bg-slate-200/50 dark:bg-slate-800/50"></div>
                                </div>
                                <div class="mt-3 h-8 w-20 rounded-full bg-slate-200/50 dark:bg-slate-800/50"></div>
                            </div>
                        }
                    }
                    else if (rowViews.Count == 0)
                    {
                        <div class="rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4 text-sm text-slate-500 dark:text-slate-400">
                            @(hasSessionFilters
                                ? "No sessions match your filters."
                                : "No sessions yet. Sync a provider to populate this list.")
                        </div>
                    }
                    else
                    {
                        @foreach (var session in rowViews)
                        {
                            <div @key="session.SessionId" class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 p-4">
                                <div class="flex items-start gap-3">
                                    @if (session.ImageUrl is not null)
                                    {
                                        <img src="@session.ImageUrl"
                                             alt="@($"{session.Title} capsule art")"
                                             class="h-14 w-10 rounded-xl border border-slate-200 dark:border-slate-800 object-cover" />
                                    }
                                    else
                                    {
                                        <div class="h-14 w-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-200/70 dark:bg-slate-800/60"></div>
                                    }
                                    <div class="flex-1 space-y-1">
                                        <button type="button"
                                                @onclick="() => NavigateToGameAsync(session.GameId)"
                                                class="text-left font-semibold text-slate-900 dark:text-white transition hover:text-emerald-700 dark:hover:text-emerald-200">
                                            @session.Title
                                        </button>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">@session.Platform</p>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">@session.Date</p>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        @if (session.Ignored)
                                        {
                                            <span class="inline-flex h-5 w-5 items-center justify-center text-slate-500 dark:text-slate-400" title="Ignored from stats" aria-label="Ignored from stats">
                                                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5">
                                                    <circle cx="12" cy="12" r="8"></circle>
                                                    <path stroke-linecap="round" d="M8 8l8 8"></path>
                                                </svg>
                                            </span>
                                        }
                                        <span class="text-sm font-semibold text-emerald-700 dark:text-emerald-200">@session.Duration</span>
                                    </div>
                                </div>
                                <div class="mt-3 flex items-center justify-between">
                                    <span class="text-[11px] uppercase tracking-[0.3em] text-slate-500">@session.Platform</span>
                                    <SessionActions CanEdit="@session.CanEdit"
                                                    Disabled="@_state.DeletingSessionIds.Contains(session.SessionId)"
                                                    OnEdit="() => OpenSessionEditor(session.SessionId)"
                                                    OnRemove="() => RemoveSessionAsync(session.SessionId)" />
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="mt-6 hidden overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 md:block">
                <table class="w-full text-left text-sm">
                    <thead class="bg-white dark:bg-slate-950/70 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                        <tr>
                            <th class="px-4 py-3 text-left">Title</th>
                            <th class="px-4 py-3 text-left">Platform</th>
                            <th class="px-4 py-3 text-left">
                                <button type="button" @onclick='() => SortAsync("date")' class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 transition hover:text-slate-700 dark:hover:text-slate-200">
                                    Date
                                    <svg aria-hidden="true" viewBox="0 0 20 20" class='@($"h-3 w-3 {(_state.SortKey == "date" ? "text-emerald-700 dark:text-emerald-200" : "")}")' fill="currentColor">
                                        <path d='@SortIconPath("date")'></path>
                                    </svg>
                                </button>
                            </th>
                            <th class="px-4 py-3 text-right">
                                <button type="button" @onclick='() => SortAsync("duration")' class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 transition hover:text-slate-700 dark:hover:text-slate-200">
                                    Duration
                                    <svg aria-hidden="true" viewBox="0 0 20 20" class='@($"h-3 w-3 {(_state.SortKey == "duration" ? "text-emerald-700 dark:text-emerald-200" : "")}")' fill="currentColor">
                                        <path d='@SortIconPath("duration")'></path>
                                    </svg>
                                </button>
                            </th>
                            <th class="px-4 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white/80 dark:bg-slate-900/60">
                        @if (_state.IsListLoading)
                        {
                            @foreach (var row in new[] { 1, 2, 3, 4 })
                            {
                                <tr @key="row">
                                    <td class="px-4 py-4"><div class="flex items-center gap-3"><div class="h-12 w-9 rounded-lg bg-slate-200/70 dark:bg-slate-800/60"></div><div class="h-3 w-28 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div></div></td>
                                    <td class="px-4 py-4"><div class="h-3 w-16 rounded-full bg-slate-200/50 dark:bg-slate-800/50"></div></td>
                                    <td class="px-4 py-4"><div class="h-3 w-12 rounded-full bg-slate-200/50 dark:bg-slate-800/50"></div></td>
                                    <td class="px-4 py-4"><div class="ml-auto h-3 w-12 rounded-full bg-slate-200/50 dark:bg-slate-800/50"></div></td>
                                    <td class="px-4 py-4"><div class="ml-auto h-3 w-16 rounded-full bg-slate-200/40 dark:bg-slate-800/40"></div></td>
                                </tr>
                            }
                        }
                        else if (rowViews.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="px-4 py-10 text-center text-sm text-slate-500 dark:text-slate-400">
                                    @(hasSessionFilters
                                        ? "No sessions match your filters."
                                        : "No sessions yet. Sync a provider to populate this list.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var session in rowViews)
                            {
                                <tr @key="session.SessionId" class="transition hover:bg-slate-100 dark:hover:bg-slate-900/70">
                                    <td class="px-4 py-3">
                                        <div class="flex items-center gap-3">
                                            @if (session.ImageUrl is not null)
                                            {
                                                <img src="@session.ImageUrl" alt="@($"{session.Title} capsule art")" class="h-12 w-9 rounded-lg border border-slate-200 dark:border-slate-800 object-cover" />
                                            }
                                            else
                                            {
                                                <div class="h-12 w-9 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-200/70 dark:bg-slate-800/60"></div>
                                            }
                                            <button type="button" @onclick="() => NavigateToGameAsync(session.GameId)" class="text-left font-semibold text-slate-900 dark:text-white transition hover:text-emerald-700 dark:hover:text-emerald-200">
                                                @session.Title
                                            </button>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-slate-600 dark:text-slate-300">@session.Platform</td>
                                    <td class="px-4 py-3 text-slate-600 dark:text-slate-300">@session.Date</td>
                                    <td class="px-4 py-3 text-right text-emerald-700 dark:text-emerald-200">
                                        <div class="inline-flex items-center justify-end gap-2">
                                            @if (session.Ignored)
                                            {
                                                <span class="inline-flex h-5 w-5 items-center justify-center text-slate-500 dark:text-slate-400" title="Ignored from stats" aria-label="Ignored from stats">
                                                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5">
                                                        <circle cx="12" cy="12" r="8"></circle>
                                                        <path stroke-linecap="round" d="M8 8l8 8"></path>
                                                    </svg>
                                                </span>
                                            }
                                            <span>@session.Duration</span>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <SessionActions CanEdit="@session.CanEdit"
                                                        Disabled="@_state.DeletingSessionIds.Contains(session.SessionId)"
                                                        OnEdit="() => OpenSessionEditor(session.SessionId)"
                                                        OnRemove="() => RemoveSessionAsync(session.SessionId)" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-600 dark:text-slate-300">
                <p>Showing @_state.Start-@_state.End of @_state.Total sessions</p>
                <div class="flex items-center gap-2">
                    <button type="button"
                            disabled="@(_state.Offset == 0 || _state.IsListLoading)"
                            @onclick="PreviousPageAsync"
                            class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-2 font-semibold uppercase tracking-[0.3em] text-slate-700 dark:text-slate-200">
                        Prev
                    </button>
                    @foreach (var page in _state.PageNumbers)
                    {
                        <button @key="page"
                                type="button"
                                @onclick="() => SetPageAsync(page)"
                                class="@(page == _state.CurrentPage
                                    ? "flex h-9 w-9 items-center justify-center rounded-full text-xs font-semibold leading-none bg-emerald-400 text-slate-900"
                                    : "flex h-9 w-9 items-center justify-center rounded-full text-xs font-semibold leading-none border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200")">
                            @(page)
                        </button>
                    }
                    <button type="button"
                            disabled="@(_state.Offset + SessionsState.Limit >= _state.Total || _state.IsListLoading)"
                            @onclick="NextPageAsync"
                            class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-2 font-semibold uppercase tracking-[0.3em] text-slate-700 dark:text-slate-200">
                        Next
                    </button>
                </div>
            </div>
        </section>
    </ChildContent>
    <Overlay>
        @if (_editState.Session is not null)
        {
            <SessionEditModal GameTitle="@_editState.Session.Game"
                              StartedAt="@_editState.StartedAt"
                              EndedAt="@_editState.EndedAt"
                              IsSaving="@_editState.IsSaving"
                              Error="@_editState.Error"
                              OnStartedAtChanged="_editState.SetStartedAt"
                              OnEndedAtChanged="_editState.SetEndedAt"
                              OnSave="SaveSessionEditAsync"
                              OnCancel="CancelSessionEdit" />
        }
    </Overlay>
</AppLayout>
