@page "/sessions/create"
@using Web.Infrastructure.Components
@using Web.Layout

<AppLayout Title="Session Creator" OnThemeChanged="SetTheme">
    <ChildContent>
        <section class="mt-10 space-y-6">
            <header class="rounded-3xl border border-slate-200 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/60 sm:p-6">
                <Breadcrumbs ParentLabel="Sessions"
                             CurrentLabel="Session Creator"
                             OnParent="BackToSessionsAsync" />
                <div class="mt-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">Extended mode</p>
                </div>

                <div role="tablist" aria-label="Session creation method" class="mt-6 inline-flex w-full rounded-2xl bg-slate-100 p-1 dark:bg-slate-950 sm:w-auto">
                    <button type="button" role="tab" data-workspace-tab="manual" aria-selected="@WorkspaceTabSelected(false)" @onclick="ShowManual"
                            class="@WorkspaceTabClass(false)">
                        Manual session
                    </button>
                    <button type="button" role="tab" data-workspace-tab="ai" aria-selected="@WorkspaceTabSelected(true)" @onclick="OpenDrafts"
                            class="@WorkspaceTabClass(true)">
                        AI batches
                    </button>
                </div>
            </header>

            @if (_draftsOpen)
            {
                <DraftWorkspace Embedded="true" Capabilities="_draftCapabilities" Platforms="_platforms" OnClose="CloseDrafts" OnAccepted="DraftsAcceptedAsync" />
            }
            else
            {
                <SessionCreateModal Embedded="true" State="_state" AiAvailable="_draftCapabilities?.Available == true" Platforms="_platforms" OnUseAi="OpenDrafts" OnQueryChanged="QueryChanged" OnSearch="SearchAsync" OnSave="SaveAsync" OnClose="BackToSessionsAsync" />
            }
        </section>
    </ChildContent>
</AppLayout>
