@page "/games/{*Hash}"
@using Web.Layout
@using Web.Shared.Common

<AppLayout Title="Game">
    <div class="mt-6 rounded-2xl border border-emerald-400/30 dark:border-emerald-300/20 bg-gradient-to-r from-emerald-400/10 via-amber-300/20 to-white/40 dark:from-emerald-500/10 dark:via-amber-500/10 dark:to-slate-900/40 px-4 py-4 sm:px-6">
        <h2 class="bg-gradient-to-r from-slate-900 via-emerald-800 to-amber-700 bg-clip-text text-3xl font-semibold tracking-tight text-transparent dark:from-white dark:via-emerald-200 dark:to-amber-200 sm:text-4xl">
            @_state.DisplayTitle
        </h2>
    </div>

    @if (_state.GameDetailsError.Length > 0)
    {
        <p class="mt-4 text-xs text-rose-700 dark:text-rose-300">@_state.GameDetailsError</p>
    }

    <section class="mt-6 space-y-6">
        <div class="grid gap-6 lg:grid-cols-[1fr_2fr]">
            <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
                <div class="aspect-[9/14] overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60">
                    @if (_state.GameImage is not null)
                    {
                        <img src="@_state.GameImage"
                             alt="@($"{_state.DisplayTitle} cover")"
                             class="h-full w-full object-cover" />
                    }
                    else
                    {
                        <div class="h-full w-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                    }
                </div>

                <div class="mt-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-gradient-to-br from-amber-400/10 via-slate-200/70 dark:via-slate-950/70 to-emerald-500/10 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <p class="text-xs uppercase tracking-[0.3em] text-amber-700 dark:text-amber-300">Your score</p>
                            @if (_state.IsRatingLoading)
                            {
                                <p class="mt-1 text-sm text-slate-700 dark:text-slate-200">Loading rating...</p>
                            }
                        </div>
                        <button type="button"
                                class="rounded-full border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-950/70 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.25em] text-slate-700 dark:text-slate-200 transition hover:border-amber-300/70 hover:text-amber-700 dark:hover:text-amber-200 disabled:cursor-not-allowed disabled:border-slate-200 dark:disabled:border-slate-800 disabled:text-slate-600"
                                @onclick="() => RateGameAsync(null)"
                                disabled="@(_state.RatingDisabled || _state.Rating is null)">
                            @(_state.IsRatingSaving ? "Clearing..." : "Clear")
                        </button>
                    </div>

                    <div class="mt-4 flex flex-wrap items-center gap-3">
                        <div class="flex items-center gap-2">
                            @foreach (var value in Enumerable.Range(1, 5))
                            {
                                var filled = _state.Rating is not null && value <= _state.Rating;
                                <button type="button"
                                        class="@($"flex h-11 w-11 items-center justify-center rounded-xl border text-sm font-semibold transition {(filled ? "border-amber-200 bg-amber-400/15 text-amber-700 dark:text-amber-100 shadow-[0_10px_40px_-20px_rgba(251,191,36,0.6)]" : "border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-950/70 text-slate-500 hover:border-amber-200/60 hover:text-amber-700 dark:hover:text-amber-200")} {(_state.RatingDisabled ? "cursor-not-allowed opacity-60" : "hover:-translate-y-0.5")}")"
                                        disabled="@_state.RatingDisabled"
                                        @onclick="() => RateGameAsync(value)">
                                    <svg aria-hidden="true"
                                         viewBox="0 0 24 24"
                                         class="@($"h-6 w-6 drop-shadow {(filled ? "text-amber-700 dark:text-amber-300" : "text-slate-600")}")"
                                         fill="@(filled ? "currentColor" : "none")"
                                         stroke="currentColor"
                                         stroke-width="1.5">
                                        <path d="M12 2.75 9.2 8.62l-6.2.54 4.7 4.06-1.4 5.98L12 16.9l5.7 3.3-1.4-5.98 4.7-4.06-6.2-.54z"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />
                                    </svg>
                                    <span class="sr-only">Rate @value out of 5</span>
                                </button>
                            }
                        </div>
                        <span class="text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
                            @if (_state.IsRatingLoading)
                            {
                                @:Loading rating...
                            }
                            else if (_state.Rating is null)
                            {
                                @:Not rated
                            }
                            else
                            {
                                @($"{_state.Rating}/5 · {_state.RatingLabel}")
                            }
                        </span>
                    </div>

                    @if (_state.RatingError.Length > 0)
                    {
                        <p class="mt-3 text-xs text-rose-700 dark:text-rose-300">@_state.RatingError</p>
                    }
                    else if (_state.Requests is null && _state.SessionsLoaded)
                    {
                        <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Add a session for this game to unlock ratings.</p>
                    }
                </div>
            </div>

            <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">Recent sessions</p>
                <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">Latest play snapshots</h2>

                <div class="mt-6 space-y-4">
                    @if (_state.GameError.Length > 0)
                    {
                        <p class="text-xs text-rose-700 dark:text-rose-300">@_state.GameError</p>
                    }
                    else if (_state.IsLoading)
                    {
                        @foreach (var item in Enumerable.Range(1, 3))
                        {
                            <div @key="item" class="flex items-center gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
                                <div class="h-14 w-10 rounded-xl bg-slate-200/70 dark:bg-slate-800/60"></div>
                                <div class="flex-1 space-y-2">
                                    <div class="h-3 w-32 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                                    <div class="h-2 w-24 rounded-full bg-slate-200/40 dark:bg-slate-800/40"></div>
                                </div>
                                <div class="h-3 w-14 rounded-full bg-slate-200/70 dark:bg-slate-800/60"></div>
                            </div>
                        }
                    }
                    else if (_state.RecentSessions.Count == 0)
                    {
                        <div class="rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4 text-sm text-slate-500 dark:text-slate-400">
                            No sessions logged for this game yet.
                        </div>
                    }
                    else
                    {
                        @foreach (var session in _state.RecentSessions)
                        {
                            <div @key="session.SessionId" class="flex items-center justify-between gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
                                <div class="flex items-center gap-3">
                                    @if (session.CapsuleUrl is not null)
                                    {
                                        <img src="@session.CapsuleUrl"
                                             alt="@($"{session.Game} capsule art")"
                                             class="h-14 w-10 rounded-xl border border-slate-200 dark:border-slate-800 object-cover" />
                                    }
                                    else
                                    {
                                        <div class="h-14 w-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-200/70 dark:bg-slate-800/60"></div>
                                    }
                                    <div>
                                        <p class="text-sm font-semibold text-slate-900 dark:text-white">@Formatters.FormatDateLabel(session.StartedAt)</p>
                                        <p class="text-xs text-slate-500 dark:text-slate-400">
                                            @Formatters.FormatSessionPlatformLabel(session.Platform, session.MappedPlatform) · @Formatters.FormatTimeLabel(session.StartedAt)
                                        </p>
                                    </div>
                                </div>
                                <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-200">
                                    @Formatters.FormatDuration(SessionDates.GetDurationSeconds(session.StartedAt, session.EndedAt, DateTimeOffset.Now), DurationFormat.Short)
                                </p>
                            </div>
                        }
                    }
                </div>

                @if (_state.RecentSessions.Count > 0 && _state.RecentTotalPages > 1)
                {
                    <div class="mt-6 flex items-center justify-between text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
                        <button type="button"
                                class="rounded-full border border-slate-200 dark:border-slate-800 px-4 py-2 text-slate-700 dark:text-slate-200 transition hover:border-emerald-400/60 hover:text-emerald-700 dark:hover:text-emerald-200 disabled:cursor-not-allowed disabled:border-slate-200 dark:disabled:border-slate-800 disabled:text-slate-600"
                                @onclick="() => LoadSessionsPageAsync(_state.RecentPage - 1)"
                                disabled="@(_state.RecentPage == 1 || _state.IsRecentPageLoading)">
                            Prev
                        </button>
                        <span>Page @_state.RecentPage of @_state.RecentTotalPages</span>
                        <button type="button"
                                class="rounded-full border border-slate-200 dark:border-slate-800 px-4 py-2 text-slate-700 dark:text-slate-200 transition hover:border-emerald-400/60 hover:text-emerald-700 dark:hover:text-emerald-200 disabled:cursor-not-allowed disabled:border-slate-200 dark:disabled:border-slate-800 disabled:text-slate-600"
                                @onclick="() => LoadSessionsPageAsync(_state.RecentPage + 1)"
                                disabled="@(_state.RecentPage == _state.RecentTotalPages || _state.IsRecentPageLoading)">
                            Next
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 px-4 py-4 sm:px-6 sm:py-5">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">Tracking</p>
                    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
                        @if (_state.Requests is null)
                        {
                            @:Add a session for this game to enable tracking controls.
                        }
                        else if (_state.IsIgnored)
                        {
                            @:Scheduler will skip new sessions for this game.
                        }
                        else
                        {
                            @:Scheduler will capture new sessions for this game.
                        }
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <span class="@($"rounded-full px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.25em] {(_state.IsIgnored ? "border border-rose-400/70 text-rose-700 dark:text-rose-100" : "border border-emerald-400/70 text-emerald-700 dark:text-emerald-100")}")">
                        @if (_state.Requests is null)
                        {
                            @:Unknown
                        }
                        else if (_state.IsIgnoreChecking)
                        {
                            @:Checking...
                        }
                        else
                        {
                            @(_state.IsIgnored ? "Ignored" : "Active")
                        }
                    </span>
                    <button type="button"
                            class="@($"rounded-full px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.2em] transition disabled:cursor-not-allowed disabled:opacity-60 {(_state.IsIgnored ? "border border-emerald-300/70 text-emerald-700 dark:text-emerald-100 hover:border-emerald-200" : "border border-rose-400/70 text-rose-700 dark:text-rose-100 hover:border-rose-300")}")"
                            disabled="@(_state.IsIgnoreChecking || _state.IsIgnoreSaving || _state.Requests is null)"
                            @onclick="ToggleIgnoreAsync">
                        @if (_state.IsIgnoreSaving)
                        {
                            @:Saving...
                        }
                        else
                        {
                            @(_state.IsIgnored ? "Resume tracking" : "Ignore game")
                        }
                    </button>
                </div>
            </div>
            @if (_state.IgnoreError.Length > 0)
            {
                <p class="mt-3 text-xs text-rose-700 dark:text-rose-300">@_state.IgnoreError</p>
            }
            else if (_state.Requests is null && _state.SessionsLoaded)
            {
                <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Add a session for this game to enable tracking controls.</p>
            }
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-6">
            <div class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/70 px-4 py-3 sm:block sm:space-y-2 sm:px-5">
                <p class="text-[11px] uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Hours played</p>
                <p class="text-lg font-semibold text-slate-900 dark:text-white">@Formatters.FormatHours(_state.TotalSeconds, 1)</p>
            </div>
            <div class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/70 px-4 py-3 sm:block sm:space-y-2 sm:px-5">
                <p class="text-[11px] uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Sessions</p>
                <p class="text-lg font-semibold text-slate-900 dark:text-white">@(_state.Stats?.SessionCount ?? 0)</p>
            </div>
            <div class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/70 px-4 py-3 sm:block sm:space-y-2 sm:px-5">
                <p class="text-[11px] uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">Last played</p>
                <p class="text-lg font-semibold text-slate-900 dark:text-white">@_state.LastPlayedLabel</p>
            </div>
        </div>

        <div class="space-y-6">
            <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">All time since 2025</p>
                        <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">Yearly play time</h2>
                    </div>
                </div>
                @if (_state.StatsError.Length > 0)
                {
                    <p class="mt-4 text-xs text-rose-700 dark:text-rose-300">@_state.StatsError</p>
                }
                else if (_state.Stats is null)
                {
                    <div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(16px,1fr))] gap-2">
                        @foreach (var item in Enumerable.Range(0, 12))
                        {
                            <div @key="item" class="mx-auto h-32 w-2 rounded-md bg-slate-200/70 dark:bg-slate-800/60"></div>
                        }
                    </div>
                }
                else if (_state.YearlyStats.All(item => item.Seconds == 0))
                {
                    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No sessions recorded for this game since 2025.</p>
                }
                else
                {
                    var maxHours = Math.Max(_state.YearlyStats.Max(item => item.Hours), 1);
                    <div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(16px,1fr))] items-end gap-2">
                        @foreach (var year in _state.YearlyStats)
                        {
                            var hoursLabel = $"{Formatters.FormatHours(year.Seconds, 1)} played";
                            <div @key="year.Key" class="group relative flex flex-col gap-3">
                                <div class="pointer-events-none absolute left-1/2 top-[-6px] z-10 -translate-x-1/2 -translate-y-full rounded-md bg-white/90 dark:bg-slate-900/90 px-3 py-1 text-[10px] font-semibold text-slate-900 dark:text-slate-100 opacity-0 shadow-lg ring-1 ring-slate-300/60 dark:ring-slate-700/60 transition duration-150 group-hover:opacity-100">@hoursLabel</div>
                                <div class="flex h-32 items-end justify-center">
                                    <div aria-label="@($"{hoursLabel} in {year.Label}")"
                                         title="@hoursLabel"
                                         class="w-2 rounded-md bg-emerald-400/80"
                                         style="@($"height: {(year.Hours / maxHours) * 100}%;")"></div>
                                </div>
                                <div class="text-center text-[10px] uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@year.Label</div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">Year detail</p>
                        <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">Monthly play time</h2>
                    </div>
                    <div class="flex items-center gap-3 rounded-full border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 px-4 py-2 text-xs uppercase tracking-[0.25em] text-slate-600 dark:text-slate-300">
                        <span class="text-slate-500">Year</span>
                        <select class="bg-transparent text-slate-900 dark:text-slate-100 outline-none"
                                value="@_state.ActiveYear"
                                @onchange="ChangeYear">
                            @foreach (var year in _state.AvailableYears.Reverse())
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                </div>
                @if (_state.StatsError.Length > 0)
                {
                    <p class="mt-4 text-xs text-rose-700 dark:text-rose-300">@_state.StatsError</p>
                }
                else if (_state.Stats is null)
                {
                    <div class="mt-6 grid grid-cols-12 gap-2">
                        @foreach (var item in Enumerable.Range(0, 12))
                        {
                            <div @key="item" class="mx-auto h-32 w-2 rounded-md bg-slate-200/70 dark:bg-slate-800/60"></div>
                        }
                    </div>
                }
                else if (_state.MonthlyStats.All(item => item.Seconds == 0))
                {
                    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No sessions recorded in @_state.ActiveYear.</p>
                }
                else
                {
                    var maxMonthlyHours = Math.Max(_state.MonthlyStats.Max(item => item.Hours), 1);
                    <div class="mt-6 grid grid-cols-12 items-end gap-2">
                        @foreach (var month in _state.MonthlyStats)
                        {
                            var hoursLabel = $"{Formatters.FormatHours(month.Seconds, 1)} played";
                            <div @key="month.Key" class="group relative flex flex-col gap-3">
                                <div class="pointer-events-none absolute left-1/2 top-[-6px] z-10 -translate-x-1/2 -translate-y-full rounded-md bg-white/90 dark:bg-slate-900/90 px-3 py-1 text-[10px] font-semibold text-slate-900 dark:text-slate-100 opacity-0 shadow-lg ring-1 ring-slate-300/60 dark:ring-slate-700/60 transition duration-150 group-hover:opacity-100">@hoursLabel</div>
                                <div class="flex h-32 items-end justify-center">
                                    <div aria-label="@($"{hoursLabel} in {month.Label}")"
                                         title="@hoursLabel"
                                         class="w-2 rounded-md bg-emerald-400/80"
                                         style="@($"height: {(month.Hours / maxMonthlyHours) * 100}%;")"></div>
                                </div>
                                <div class="text-center text-[10px] uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">@month.Label</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
</AppLayout>
