@using Web.Infrastructure.Models

<section class="mt-5 rounded-2xl border border-slate-200 bg-white/70 p-4 dark:border-slate-800 dark:bg-slate-950/40" aria-label="Live session controls">
    @if (ActiveSession is not null)
    {
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="min-w-0">
                <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">Live manual session</p>
                <p class="mt-1 truncate text-sm font-semibold text-slate-900 dark:text-white">@ActiveSession.Title · @ActiveSession.PlatformName</p>
            </div>
            <button type="button" disabled="@Busy" @onclick="StopAsync" class="rounded-full border border-rose-500/60 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-rose-700 transition hover:border-rose-400 disabled:opacity-60 dark:text-rose-200">
                @(Busy ? "Stopping..." : "Stop session")
            </button>
        </div>
    }
    else
    {
        <div class="flex flex-wrap items-end gap-3">
            <label class="min-w-[14rem] flex-1 text-xs font-medium text-slate-600 dark:text-slate-300">
                Start a live session
                <input type="search" value="@_query" @oninput="ChangeQuery" placeholder="Search saved games and IGDB" autocomplete="off" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
            </label>
            <button type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_query))" @onclick="SearchAsync" class="rounded-full border border-slate-300 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700 disabled:opacity-60 dark:border-slate-700 dark:text-slate-200">@(_busy ? "Searching..." : "Search")</button>
            <label class="min-w-[10rem] text-xs font-medium text-slate-600 dark:text-slate-300">
                Platform
                <select value="@_platformKey" @onchange="ChangePlatform" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
                    <option value="">Select platform</option>
                    @foreach (var platform in Platforms) { <option value="@platform.Key">@platform.Name</option> }
                </select>
            </label>
            <button type="button" disabled="@(_busy || _selected is null || string.IsNullOrWhiteSpace(_platformKey))" @onclick="StartAsync" class="rounded-full bg-emerald-400 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-950 disabled:opacity-60">Start live session</button>
        </div>
        @if (_results.Count > 0)
        {
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
                @foreach (var result in _results)
                {
                    <button type="button" @key="@(result.GameId ?? result.IgdbId)" @onclick="() => Select(result)" class="flex items-center gap-3 rounded-xl border p-2 text-left @(ReferenceEquals(_selected, result) ? "border-emerald-400 bg-emerald-50 dark:bg-emerald-400/10" : "border-slate-200 dark:border-slate-700")">
                        @if (result.CapsuleUrl is not null) { <img src="@result.CapsuleUrl" alt="@result.Title poster" class="h-12 w-9 rounded object-cover" /> }
                        else { <span aria-hidden="true" class="flex h-12 w-9 items-center justify-center rounded bg-slate-200 text-[8px] uppercase text-slate-500 dark:bg-slate-800 dark:text-slate-400">No art</span> }
                        <span class="min-w-0"><span class="block truncate text-sm font-semibold text-slate-900 dark:text-white">@result.Title</span><span class="text-xs text-slate-500 dark:text-slate-400">@(result.Source == "local" ? "Saved game" : "IGDB")</span></span>
                    </button>
                }
            </div>
        }
    }
    @if (!string.IsNullOrWhiteSpace(Error)) { <p role="alert" class="mt-3 text-sm text-rose-700 dark:text-rose-300">@Error</p> }
</section>
