@implements IDisposable

<div class="relative z-50 w-full">
    <label for="global-game-search" class="sr-only">Search games</label>
    <div class="relative">
        <svg aria-hidden="true"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="1.75"
             class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500 dark:text-slate-400">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input id="global-game-search"
               type="search"
               role="combobox"
               aria-label="Search games"
               aria-autocomplete="list"
               aria-controls="game-search-results"
               aria-expanded="@_state.IsOpen.ToString().ToLowerInvariant()"
               aria-activedescendant="@ActiveOptionId"
               autocomplete="off"
               placeholder="Search games"
               value="@_state.Query"
               @oninput="HandleInputAsync"
               @onkeydown="HandleKeyDownAsync"
               class="w-full rounded-full border border-slate-300 bg-white/90 py-2 pl-10 pr-4 text-xs text-slate-900 outline-none transition placeholder:text-slate-500 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white dark:placeholder:text-slate-400" />
    </div>

    @if (_state.IsOpen)
    {
        <button type="button"
                aria-label="Close game search"
                @onclick="Dismiss"
                class="fixed inset-0 z-[-1] cursor-default bg-transparent"></button>
        <div id="game-search-results"
             role="listbox"
             aria-label="Game search results"
             class="absolute left-0 right-0 top-full mt-2 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-slate-950/20 dark:border-slate-700 dark:bg-slate-900">
            @if (_state.IsLoading)
            {
                <p class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">Searching...</p>
            }
            else if (_state.Error.Length > 0)
            {
                <p class="px-4 py-3 text-sm text-rose-700 dark:text-rose-300">@_state.Error</p>
            }
            else if (_state.Results.Count == 0)
            {
                <p class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">No games found.</p>
            }
            else
            {
                @for (var index = 0; index < _state.Results.Count; index++)
                {
                    var optionIndex = index;
                    var result = _state.Results[index];
                    <button @key="result.GameId"
                            id="@OptionId(optionIndex)"
                            type="button"
                            role="option"
                            aria-selected="@(optionIndex == _state.ActiveIndex)"
                            @onmouseenter="() => SetActive(optionIndex)"
                            @onclick="() => SelectAsync(result)"
                            class="flex w-full items-center gap-3 border-b border-slate-100 px-3 py-2 text-left transition last:border-b-0 hover:bg-emerald-50 dark:border-slate-800 dark:hover:bg-emerald-400/10 @(optionIndex == _state.ActiveIndex ? "bg-emerald-50 dark:bg-emerald-400/10" : "")">
                        @if (result.CapsuleUrl is not null)
                        {
                            <img src="@result.CapsuleUrl"
                                 alt=""
                                 class="h-12 w-9 shrink-0 rounded-lg border border-slate-200 object-cover dark:border-slate-700" />
                        }
                        else
                        {
                            <span aria-hidden="true" class="h-12 w-9 shrink-0 rounded-lg bg-slate-200 dark:bg-slate-800"></span>
                        }
                        <span class="min-w-0">
                            <span class="block truncate text-sm font-semibold text-slate-900 dark:text-white">@result.Title</span>
                            <span class="block truncate text-xs text-slate-500 dark:text-slate-400">@result.Platform</span>
                        </span>
                    </button>
                }
            }
        </div>
    }
</div>
