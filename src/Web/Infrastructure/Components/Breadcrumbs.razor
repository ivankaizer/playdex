@using Microsoft.AspNetCore.Components

<nav aria-label="Breadcrumb" class="text-xs font-semibold uppercase tracking-[0.16em]">
    <ol class="flex flex-wrap items-center gap-2">
        <li>
            <button type="button"
                    disabled="@Disabled"
                    @onclick="OnParent"
                    class="text-slate-500 transition hover:text-emerald-700 disabled:cursor-not-allowed disabled:opacity-60 dark:text-slate-400 dark:hover:text-emerald-300">
                @ParentLabel
            </button>
        </li>
        <li aria-hidden="true" class="text-slate-300 dark:text-slate-700">
            <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="m6 3 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </li>
        <li aria-current="page" class="text-emerald-700 dark:text-emerald-300">
            @CurrentLabel
        </li>
    </ol>
</nav>

@code {
    [Parameter, EditorRequired]
    public string ParentLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string CurrentLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public EventCallback OnParent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
