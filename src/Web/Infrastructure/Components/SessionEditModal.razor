<div class="fixed inset-0 z-[70] flex items-center justify-center bg-slate-950/65 p-4">
    <section role="dialog"
             aria-modal="true"
             aria-labelledby="session-edit-title"
             class="w-full max-w-lg rounded-3xl border border-slate-200 bg-white p-5 shadow-2xl dark:border-slate-700 dark:bg-slate-900 sm:p-6">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">Edit session</p>
                <h2 id="session-edit-title" class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">@GameTitle</h2>
            </div>
            <button type="button"
                    aria-label="Close session editor"
                    disabled="@IsSaving"
                    @onclick="OnCancel"
                    class="rounded-full border border-slate-300 px-3 py-1 text-sm text-slate-600 transition hover:border-emerald-400 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-300">
                ×
            </button>
        </div>

        <form class="mt-6 space-y-4" @onsubmit="OnSave" @onsubmit:preventDefault>
            <label class="block text-xs font-medium text-slate-600 dark:text-slate-300">
                Started
                <input type="datetime-local"
                       step="1"
                       value="@StartedAt"
                       disabled="@IsSaving"
                       @oninput="ChangeStartedAtAsync"
                       class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
            </label>
            <label class="block text-xs font-medium text-slate-600 dark:text-slate-300">
                Ended
                <input type="datetime-local"
                       step="1"
                       value="@EndedAt"
                       disabled="@IsSaving"
                       @oninput="ChangeEndedAtAsync"
                       class="mt-2 w-full rounded-xl border border-slate-300 bg-white/90 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 disabled:opacity-60 dark:border-slate-700 dark:bg-slate-950/80 dark:text-white" />
            </label>

            @if (Error.Length > 0)
            {
                <p role="alert" class="text-sm text-rose-700 dark:text-rose-300">@Error</p>
            }

            <div class="flex justify-end gap-3 pt-2">
                <button type="button"
                        data-action="cancel"
                        disabled="@IsSaving"
                        @onclick="OnCancel"
                        class="rounded-full border border-slate-300 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700 transition hover:border-emerald-400 disabled:cursor-not-allowed disabled:opacity-60 dark:border-slate-700 dark:text-slate-200">
                    Cancel
                </button>
                <button type="submit"
                        data-action="save"
                        disabled="@IsSaving"
                        class="rounded-full bg-emerald-400 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-950 transition hover:bg-emerald-300 disabled:cursor-not-allowed disabled:opacity-60">
                    @(IsSaving ? "Saving..." : "Save changes")
                </button>
            </div>
        </form>
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public string GameTitle { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string StartedAt { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string EndedAt { get; set; } = string.Empty;

    [Parameter]
    public bool IsSaving { get; set; }

    [Parameter]
    public string Error { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnStartedAtChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnEndedAtChanged { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Task ChangeStartedAtAsync(ChangeEventArgs eventArgs) =>
        OnStartedAtChanged.InvokeAsync(eventArgs.Value?.ToString() ?? string.Empty);

    private Task ChangeEndedAtAsync(ChangeEventArgs eventArgs) =>
        OnEndedAtChanged.InvokeAsync(eventArgs.Value?.ToString() ?? string.Empty);
}
