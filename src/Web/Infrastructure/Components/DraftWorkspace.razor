@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject PlaydexApiClient Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@(Embedded ? "w-full" : "fixed inset-0 z-[80] overflow-y-auto bg-slate-950/65 p-4")">
    <section role="@(Embedded ? null : "dialog")"
             aria-modal="@(Embedded ? null : "true")"
             aria-label="AI session drafts"
             data-layout="@(Embedded ? "extended-ai" : null)"
             class="@(Embedded ? "w-full text-slate-900 dark:text-white" : "mx-auto my-8 w-full max-w-5xl rounded-3xl bg-slate-50 p-5 text-slate-900 shadow-xl dark:bg-slate-950 dark:text-white sm:p-6")">
        @if (!Embedded)
        {
            <div class="mb-5 flex items-start justify-between gap-4 rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">AI session import</p>
                    <h2 class="mt-2 text-xl font-semibold">Review session drafts</h2>
                </div>
                <button disabled="@_busy" @onclick="CloseAsync"
                        class="rounded-full border border-slate-300 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] dark:border-slate-700">Close</button>
            </div>
        }

        @if (_error.Length > 0)
        {
            <p role="alert" class="mb-5 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700 dark:border-rose-400/20 dark:bg-rose-400/10 dark:text-rose-200">@_error</p>
        }
        @if (_outcome.Length > 0)
        {
            <p role="status" class="mb-5 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800 dark:border-emerald-400/20 dark:bg-emerald-400/10 dark:text-emerald-200">@_outcome</p>
        }

        @if (_batch is null)
        {
            <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_20rem]">
                <section class="rounded-3xl border border-slate-200 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/60 sm:p-6">
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">Natural input</p>
                    <h2 class="mt-2 text-xl font-semibold">Create AI batch</h2>
                    <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">Describe one or several play sessions, add a screenshot, or use both. You will review every suggestion before it reaches your history.</p>

                    @if (Capabilities?.Available == true)
                    {
                        <div class="mt-6">
                            <label class="block text-sm font-semibold text-slate-800 dark:text-slate-100">
                                What did you play?
                                <textarea rows="7" maxlength="@Capabilities.MaxTextCharacters" @bind="_text" @bind:event="oninput" disabled="@_busy"
                                          placeholder="For example: Yesterday I played Hades II on PC for 1 hour 20 minutes."
                                          class="mt-2 block w-full resize-y rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm font-normal text-slate-900 outline-none placeholder:text-slate-400 focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-950 dark:text-white"></textarea>
                            </label>
                            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Up to @Capabilities.MaxTextCharacters characters and @Capabilities.MaxRows sessions.</p>
                        </div>

                        <div id="@_pasteId" tabindex="0" class="mt-5 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4 outline-none focus:border-emerald-400 dark:border-slate-700 dark:bg-slate-950/70">
                            <label class="block text-sm font-semibold text-slate-800 dark:text-slate-100">
                                Add a screenshot
                                <span class="mt-1 block text-xs font-normal text-slate-500 dark:text-slate-400">Choose a file or paste an image while this area is focused.</span>
                                <InputFile OnChange="LoadImageAsync" accept="image/png,image/jpeg,image/webp" disabled="@_busy"
                                           class="mt-3 block w-full text-xs text-slate-500 file:mr-3 file:rounded-full file:border-0 file:bg-emerald-400 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-slate-950 dark:text-slate-400" />
                            </label>
                            @if (_image is not null)
                            {
                                <div class="mt-4 flex flex-col items-start gap-3 rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900 sm:flex-row">
                                    <img src="@_preview" alt="Screenshot to be sent for extraction" class="max-h-48 max-w-full rounded-xl object-contain sm:max-w-xs" />
                                    <button type="button" disabled="@_busy" @onclick="RemoveImage"
                                            class="rounded-full border border-slate-300 px-4 py-2 text-xs font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">Remove screenshot</button>
                                </div>
                            }
                        </div>

                        <div class="mt-5 flex flex-col gap-4 border-t border-slate-200 pt-5 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between">
                            <p class="max-w-2xl text-xs leading-5 text-slate-500 dark:text-slate-400">Text and screenshots are sent to @Capabilities.Provider for processing and are not retained by Playdex. Supported: PNG, JPEG, WebP up to @(Capabilities.MaxImageBytes / 1024 / 1024) MiB and @(Capabilities.MaxImagePixels / 1000000) megapixels.</p>
                            <button type="button" disabled="@(_busy || (string.IsNullOrWhiteSpace(_text) && _image is null))" @onclick="GenerateAsync"
                                    class="shrink-0 rounded-full bg-emerald-400 px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.18em] text-slate-950 disabled:opacity-60">
                                @(_busy ? "Generating drafts…" : "Generate drafts")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-400/20 dark:bg-amber-400/10 dark:text-amber-200">
                            AI generation is currently unavailable. Saved drafts remain available for review, and you can use the Manual session tab.
                        </div>
                    }
                </section>

                <aside class="rounded-3xl border border-slate-200 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/60 lg:sticky lg:top-6">
                    <div class="flex items-center justify-between gap-3">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Review queue</p>
                            <h2 class="mt-2 text-lg font-semibold">Saved batches</h2>
                        </div>
                        @if (_batches.Count > 0)
                        {
                            <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:bg-emerald-400/15 dark:text-emerald-200">@_batches.Count</span>
                        }
                    </div>

                    <div class="mt-4 space-y-2">
                        @foreach (var batch in _batches)
                        {
                            <button type="button" disabled="@_busy" @onclick="() => ResumeAsync(batch.Id)"
                                    class="w-full rounded-2xl border border-slate-200 bg-slate-50 p-3 text-left transition hover:border-emerald-400 hover:bg-emerald-50 dark:border-slate-700 dark:bg-slate-950/70 dark:hover:bg-emerald-400/10">
                                <span class="block text-sm font-semibold">Resume @batch.CreatedAt.ToLocalTime().ToString("g")</span>
                                <span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">@batch.Rows.Count(row => row.Status == "pending") pending</span>
                            </button>
                        }
                        @if (_batches.Count == 0)
                        {
                            <div class="rounded-2xl bg-slate-100 p-4 text-sm text-slate-500 dark:bg-slate-950 dark:text-slate-400">
                                <p class="font-semibold text-slate-700 dark:text-slate-200">No saved drafts.</p>
                                <p class="mt-1 text-xs leading-5">Generated batches appear here until every pending row is accepted or deleted.</p>
                            </div>
                        }
                    </div>
                </aside>
            </div>
        }
        else
        {
            <div class="rounded-3xl border border-slate-200 bg-white/80 p-5 dark:border-slate-800 dark:bg-slate-900/60 sm:p-6">
                <Breadcrumbs ParentLabel="Saved batches"
                             CurrentLabel="Review batch"
                             OnParent="BackAsync"
                             Disabled="@_busy" />
                <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">AI batch review</p>
                        <h2 class="mt-2 text-xl font-semibold">Review extracted sessions</h2>
                        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Correct the details and choose a verified game before accepting each session.</p>
                    </div>
                    <button type="button" disabled="@(_busy || !_rows.Any(row => row.CanAccept))" @onclick="() => AcceptAsync(_rows.Where(row => row.CanAccept).ToArray())"
                            class="shrink-0 rounded-full bg-emerald-400 px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-slate-950 disabled:opacity-60">Accept all ready</button>
                </div>
            </div>

            @if (_rows.Count == 0)
            {
                <p class="mt-5 rounded-3xl border border-slate-200 bg-white/80 p-6 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300">No eligible session evidence was found. Try describing individual plays with a date and duration.</p>
            }

            <div class="mt-5 space-y-3">
                @foreach (var row in _rows)
                {
                    <article @key="row.Id"
                             data-draft-row
                             class="rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-slate-800 dark:bg-slate-900/60">
                        <fieldset disabled="@(_busy || row.IsAccepted)">
                            <div class="flex items-center justify-between gap-3">
                                <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-emerald-700 dark:text-emerald-300">Session draft</p>
                                @if (row.IsAccepted)
                                {
                                    <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-emerald-800 dark:bg-emerald-400/15 dark:text-emerald-200">Accepted</span>
                                }
                            </div>

                            <div data-draft-row-fields
                                 class="mt-3 grid gap-3 md:grid-cols-2 xl:grid-cols-[minmax(18rem,2fr)_minmax(9rem,0.8fr)_minmax(9rem,0.8fr)_minmax(10rem,1fr)_auto] xl:items-end">
                                <div class="md:col-span-2 xl:col-span-1">
                                    <label class="block text-xs font-medium text-slate-600 dark:text-slate-300">
                                        Game match
                                        <span class="mt-1 flex items-center gap-2">
                                            <input data-game-search
                                                   value="@row.Title"
                                                   @oninput="e => row.SetTitle(e.Value?.ToString() ?? string.Empty)"
                                                   aria-invalid="@AriaInvalid(!row.HasGameSelection)"
                                                   placeholder="Search saved games and IGDB"
                                                   class="block min-w-0 flex-1 rounded-xl border px-3 py-2 text-sm text-slate-900 outline-none dark:text-white @ReviewFieldClass(!row.HasGameSelection)" />
                                            <button type="button"
                                                    @onclick="() => SearchAsync(row)"
                                                    class="shrink-0 rounded-xl border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-emerald-400 dark:border-slate-700 dark:text-slate-200">
                                                Find game
                                            </button>
                                        </span>
                                    </label>
                                    @if (row.Selection is {} selected)
                                    {
                                        <div class="mt-2 flex min-w-0 items-center gap-2 rounded-xl border border-emerald-300/60 bg-emerald-50 px-2 py-1.5 dark:border-emerald-400/30 dark:bg-emerald-400/10">
                                            @if (selected.CapsuleUrl is not null)
                                            {
                                                <img src="@selected.CapsuleUrl" alt="@selected.Title poster" class="h-10 w-8 shrink-0 rounded-md object-cover" />
                                            }
                                            else
                                            {
                                                <span aria-hidden="true" class="flex h-10 w-8 shrink-0 items-center justify-center rounded-md bg-slate-200 text-[7px] uppercase text-slate-500 dark:bg-slate-800 dark:text-slate-400">No art</span>
                                            }
                                            <span class="min-w-0">
                                                <span class="block truncate text-sm font-semibold">@selected.Title</span>
                                                <span class="block text-[10px] font-semibold uppercase tracking-[0.16em] text-emerald-700 dark:text-emerald-300">Matched from @(selected.Source == "local" ? "saved game" : "IGDB")</span>
                                            </span>
                                        </div>
                                    }
                                </div>

                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300">
                                    Date
                                    <input type="date" value="@row.Date" @onchange="e => row.Date = e.Value?.ToString() ?? string.Empty"
                                           aria-invalid="@AriaInvalid(!row.HasValidDate)"
                                           class="mt-1 block w-full rounded-xl border px-3 py-2 text-sm outline-none dark:text-white @ReviewFieldClass(!row.HasValidDate)" />
                                </label>

                                <div>
                                    <span class="block text-xs font-medium text-slate-600 dark:text-slate-300">Duration</span>
                                    <div class="mt-1 grid grid-cols-2 gap-2">
                                        <label class="sr-only" for="@($"draft-hours-{row.Id}")">Hours</label>
                                        <input id="@($"draft-hours-{row.Id}")" aria-label="Hours" type="number" min="0" step="1" @bind="row.Hours"
                                               aria-invalid="@AriaInvalid(!row.HasValidDuration)"
                                               class="block w-full rounded-xl border px-2 py-2 text-sm outline-none dark:text-white @ReviewFieldClass(!row.HasValidDuration)" />
                                        <label class="sr-only" for="@($"draft-minutes-{row.Id}")">Minutes</label>
                                        <input id="@($"draft-minutes-{row.Id}")" aria-label="Minutes" type="number" min="0" step="1" @bind="row.Minutes"
                                               aria-invalid="@AriaInvalid(!row.HasValidDuration)"
                                               class="block w-full rounded-xl border px-2 py-2 text-sm outline-none dark:text-white @ReviewFieldClass(!row.HasValidDuration)" />
                                    </div>
                                </div>

                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300">
                                    Platform
                                    <select @bind="row.PlatformKey" data-needs-review="@row.NeedsPlatformReview"
                                            class="mt-1 block w-full rounded-xl border px-3 py-2 text-sm outline-none dark:text-white @ReviewFieldClass(row.NeedsPlatformReview)">
                                        @foreach (var platform in Platforms)
                                        {
                                            <option value="@platform.Key">@platform.Name</option>
                                        }
                                        @if (!Platforms.Any(p => p.Key == "unknown"))
                                        {
                                            <option value="unknown">Unknown</option>
                                        }
                                    </select>
                                </label>

                                <div class="flex flex-wrap items-center gap-2 md:col-span-2 xl:col-span-1 xl:justify-end">
                                    <button type="button" @onclick="() => SaveActionAsync(row)"
                                            class="rounded-xl border border-slate-300 px-3 py-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-700 dark:border-slate-700 dark:text-slate-200">Save edits</button>
                                    <button type="button" @onclick="() => DeleteAsync(row)"
                                            class="rounded-xl border border-rose-200 px-3 py-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-rose-700 dark:border-rose-400/30 dark:text-rose-200">Delete draft</button>
                                    <button type="button" disabled="@(!row.CanAccept)" @onclick="() => AcceptAsync([row])"
                                            class="rounded-xl bg-emerald-400 px-3 py-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-950 disabled:opacity-60">Accept</button>
                                </div>

                                @if (row.Results.Count > 0)
                                {
                                    <div class="grid max-h-56 gap-2 overflow-y-auto border-t border-slate-200 pt-3 md:col-span-2 sm:grid-cols-2 lg:grid-cols-3 xl:col-span-5 xl:grid-cols-4 dark:border-slate-800">
                                        @foreach (var result in row.Results)
                                        {
                                            <button type="button"
                                                    data-game-result
                                                    data-game-result-source="@result.Source"
                                                    class="flex min-w-0 items-center gap-2 rounded-xl border border-slate-200 bg-white p-2 text-left transition hover:border-emerald-400 dark:border-slate-700 dark:bg-slate-950"
                                                    @onclick="() => ChooseAsync(row, result)">
                                                @if (result.CapsuleUrl is not null)
                                                {
                                                    <img src="@result.CapsuleUrl" alt="@result.Title poster" class="h-12 w-9 shrink-0 rounded-md object-cover" />
                                                }
                                                else
                                                {
                                                    <span aria-hidden="true" class="flex h-12 w-9 shrink-0 items-center justify-center rounded-md bg-slate-200 text-[7px] uppercase text-slate-500 dark:bg-slate-800 dark:text-slate-400">No art</span>
                                                }
                                                <span class="min-w-0">
                                                    <span class="block truncate text-sm font-semibold">@result.Title</span>
                                                    <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">@(result.Source == "local" ? "Saved game" : "IGDB")</span>
                                                </span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                        </fieldset>
                        @if (row.Error.Length > 0)
                        {
                            <p role="alert" class="mt-4 rounded-xl bg-rose-50 p-3 text-sm text-rose-700 dark:bg-rose-400/10 dark:text-rose-200">@row.Error</p>
                        }
                        @if (row.IsAccepted)
                        {
                            <p role="status" class="mt-4 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800 dark:bg-emerald-400/10 dark:text-emerald-200">Accepted — session saved.</p>
                        }
                    </article>
                }
            </div>
        }
    </section>
</div>
