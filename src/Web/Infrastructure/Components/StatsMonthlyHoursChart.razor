@using System.Globalization
@using Web.Infrastructure.Common
@using Web.Infrastructure.Models

@if (Months.Count == 0)
{
    <p class="text-sm text-slate-500 dark:text-slate-400">No monthly data available.</p>
}
else
{
    var spansYears = StatsMonthLabels.SpansYears(Months);
    var maxHours = Math.Max(Months.Max(item => item.TotalSeconds / 3600), 1);
    <div class="overflow-x-auto pb-2" aria-label="Hours per month">
        <div class="flex min-w-max items-end gap-3" role="list">
            @foreach (var month in Months)
            {
                var label = StatsMonthLabels.Format(month, spansYears);
                var hoursLabel = Formatters.FormatHours(month.TotalSeconds, 1);
                <div @key="@($"{month.Year}-{month.Month}")"
                     class="group relative flex w-12 shrink-0 flex-col gap-3"
                     role="listitem">
                    <div class="pointer-events-none absolute left-1/2 top-[-6px] z-10 -translate-x-1/2 -translate-y-full whitespace-nowrap rounded-md bg-white/95 px-3 py-1 text-[10px] font-semibold text-slate-900 opacity-0 shadow-lg ring-1 ring-slate-300/60 transition group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-slate-900/95 dark:text-slate-100 dark:ring-slate-700/60">
                        @hoursLabel
                    </div>
                    <div class="flex h-32 items-end justify-center">
                        <div tabindex="0"
                             aria-label="@($"{hoursLabel} played in {label}")"
                             title="@hoursLabel"
                             class="w-3 rounded-t-md bg-emerald-400/80 outline-none focus:ring-2 focus:ring-emerald-500"
                             style="@HeightStyle(month.TotalSeconds, maxHours)"></div>
                    </div>
                    <div class="text-center text-[10px] uppercase tracking-[0.15em] text-slate-500 dark:text-slate-400">
                        @label
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<AccountMonthStat> Months { get; set; } = [];

    private static string HeightStyle(double totalSeconds, double maxHours) =>
        $"height: {(totalSeconds / 3600 / maxHours * 100).ToString(CultureInfo.InvariantCulture)}%;";
}
