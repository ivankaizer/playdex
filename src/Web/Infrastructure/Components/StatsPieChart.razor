@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

@{
    const double strokeWidth = 18;
    var radius = (Size - strokeWidth) / 2;
    var circumference = 2 * Math.PI * radius;
    var total = Math.Max(Segments.Sum(segment => segment.Value), 1);
    var offset = 0d;
}

<svg role="group"
     aria-label="Platform distribution"
     width="@Size"
     height="@Size"
     viewBox="@($"0 0 {Size} {Size}")"
     class="shrink-0">
    <circle cx="@Invariant(Size / 2d)"
            cy="@Invariant(Size / 2d)"
            r="@Invariant(radius)"
            fill="transparent"
            stroke="currentColor"
            stroke-width="@Invariant(strokeWidth)"
            aria-hidden="true"
            class="text-slate-200 dark:text-slate-800"></circle>
    @for (var index = 0; index < Segments.Count; index++)
    {
        var segment = Segments[index];
        var dash = segment.Value / total * circumference;
        var gap = circumference - dash;
        var strokeDashOffset = -offset;
        offset += dash;

        <circle cx="@Invariant(Size / 2d)"
                cy="@Invariant(Size / 2d)"
                r="@Invariant(radius)"
                fill="transparent"
                stroke="@ColorAt(index)"
                stroke-width="@Invariant(SelectedKey == segment.Key ? strokeWidth + 4 : strokeWidth)"
                stroke-dasharray="@($"{Invariant(dash)} {Invariant(gap)}")"
                stroke-dashoffset="@Invariant(strokeDashOffset)"
                opacity="@(SelectedKey.Length > 0 && SelectedKey != segment.Key ? "0.35" : "1")"
                role="@(OnSegmentSelect.HasDelegate ? "button" : null)"
                tabindex="@(OnSegmentSelect.HasDelegate ? "0" : null)"
                aria-label="@($"Filter by {segment.Label}: {Invariant(segment.Value)} percent")"
                aria-pressed="@(OnSegmentSelect.HasDelegate ? SelectedKey == segment.Key ? "true" : "false" : null)"
                @onclick="() => SelectAsync(segment.Key)"
                @onkeydown="eventArgs => HandleKeyDownAsync(eventArgs, segment.Key)"
                @onkeydown:preventDefault="OnSegmentSelect.HasDelegate"
                transform="@($"rotate(-90 {Invariant(Size / 2d)} {Invariant(Size / 2d)})")"
                class="@(OnSegmentSelect.HasDelegate ? "cursor-pointer outline-none focus:opacity-80" : null)"></circle>
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<(string Key, string Label, double Value)> Segments { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Colors { get; set; } = [];

    [Parameter]
    public int Size { get; set; } = 150;

    [Parameter]
    public string SelectedKey { get; set; } = "";

    [Parameter]
    public EventCallback<string> OnSegmentSelect { get; set; }

    private Task SelectAsync(string key) =>
        OnSegmentSelect.HasDelegate ? OnSegmentSelect.InvokeAsync(key) : Task.CompletedTask;

    private Task HandleKeyDownAsync(KeyboardEventArgs eventArgs, string key) =>
        eventArgs.Key is "Enter" or " " ? SelectAsync(key) : Task.CompletedTask;

    private string? ColorAt(int index) => Colors.Count == 0 ? null : Colors[index % Colors.Count];

    private static string Invariant(double value) =>
        value.ToString(CultureInfo.InvariantCulture);
}
