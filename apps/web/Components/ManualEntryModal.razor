@using Microsoft.AspNetCore.Components
@using Playdex.Web.Models
@using Playdex.Web.Utilities

@if (IsOpen)
{
    var localResults = ManualEntrySearchResults.Where(result => result.Source == "local");
    var igdbResults = ManualEntrySearchResults.Where(result => result.Source == "igdb");

    <div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-900/30 px-4 py-4 dark:bg-slate-950/80 sm:items-center sm:py-8">
        <div class="my-auto flex w-full max-w-2xl flex-col rounded-3xl border border-slate-200 bg-white/90 p-5 shadow-[0_30px_80px_rgba(15,23,42,0.7)] dark:border-slate-800 dark:bg-slate-900/90 sm:p-6 max-h-[calc(100dvh-2rem)]">
            <div class="flex items-center justify-between gap-4">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                        Manual entry
                    </p>
                    <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">
                        Log a time entry
                    </h2>
                </div>
                <button type="button"
                        @onclick="OnClose"
                        class="rounded-full border border-slate-300 dark:border-slate-700 px-3 py-1 text-xs font-semibold uppercase tracking-[0.3em] text-slate-700 dark:text-slate-200">
                    Close
                </button>
            </div>

            <div class="mt-6 grid min-h-0 gap-4 overflow-y-auto pr-1">
                <div class="grid gap-3 sm:grid-cols-[0.7fr_0.3fr]">
                    <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                        Date
                        <input type="date"
                               value="@ManualEntryDate"
                               @onchange="eventArgs => OnDateChange.InvokeAsync(eventArgs.Value?.ToString() ?? string.Empty)"
                               class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-3 py-2 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30" />
                    </label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                            Hours
                            <input type="number"
                                   min="0"
                                   step="1"
                                   value="@ManualEntryHours"
                                   @oninput="eventArgs => OnHoursChange.InvokeAsync(eventArgs.Value?.ToString() ?? string.Empty)"
                                   class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-3 py-2 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30" />
                        </label>
                        <label class="text-xs font-medium text-slate-600 dark:text-slate-300">
                            Minutes
                            <input type="number"
                                   min="0"
                                   step="1"
                                   value="@ManualEntryMinutes"
                                   @oninput="eventArgs => OnMinutesChange.InvokeAsync(eventArgs.Value?.ToString() ?? string.Empty)"
                                   class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-3 py-2 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30" />
                        </label>
                    </div>
                </div>

                <div class="flex flex-wrap items-end gap-3">
                    <label class="flex-1 text-xs font-medium text-slate-600 dark:text-slate-300">
                        Search by name
                        <input type="text"
                               value="@ManualEntrySearchQuery"
                               @oninput="eventArgs => OnSearchQueryChange.InvokeAsync(eventArgs.Value?.ToString() ?? string.Empty)"
                               placeholder="Search games"
                               class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-3 py-2 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30" />
                    </label>
                    <button type="button"
                            @onclick="OnSearch"
                            disabled="@IsManualEntrySearchLoading"
                            class="rounded-full bg-emerald-400 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-slate-900 transition hover:bg-emerald-300 disabled:cursor-not-allowed disabled:bg-emerald-300/60">
                        @(IsManualEntrySearchLoading ? "Searching..." : "Search")
                    </button>
                </div>

                @if (!ManualEntryIgdbAvailable)
                {
                    <p class="text-xs text-amber-700 dark:text-amber-200">
                        IGDB is not configured on the server.
                    </p>
                }

                @if (!string.IsNullOrEmpty(ManualEntrySearchError))
                {
                    <p class="text-xs text-rose-700 dark:text-rose-300">
                        @ManualEntrySearchError
                    </p>
                }

                <div class="grid gap-3 lg:grid-cols-2">
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
                        <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                            Existing games
                        </p>
                        <div class="mt-3 max-h-64 space-y-2 overflow-y-auto pr-1">
                            @if (!localResults.Any())
                            {
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    Search to see saved games.
                                </p>
                            }
                            else
                            {
                                @foreach (var result in localResults)
                                {
                                    <button @key="@($"local-{result.GameId}")"
                                            type="button"
                                            @onclick="() => OnSelectResult.InvokeAsync(result)"
                                            class="@(ManualEntrySelection?.GameId == result.GameId
                                                ? "flex w-full items-center justify-between gap-3 rounded-xl border px-3 py-2 text-left text-sm transition border-emerald-400/60 bg-emerald-400/10 text-emerald-700 dark:text-emerald-100"
                                                : "flex w-full items-center justify-between gap-3 rounded-xl border px-3 py-2 text-left text-sm transition border-slate-200 dark:border-slate-800 bg-slate-200/40 dark:bg-slate-950/40 text-slate-700 dark:text-slate-200 hover:border-emerald-400/40")">
                                        <span>@Formatters.FormatEntryResultLabel(result.Source, result.Title, result.Platform)</span>
                                        <span class="text-[10px] uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                                            Local
                                        </span>
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
                        <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                            IGDB results
                        </p>
                        <div class="mt-3 max-h-64 space-y-2 overflow-y-auto pr-1">
                            @if (!igdbResults.Any())
                            {
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    Search to see IGDB matches.
                                </p>
                            }
                            else
                            {
                                @foreach (var result in igdbResults)
                                {
                                    <button @key="@($"igdb-{result.IgdbId}")"
                                            type="button"
                                            @onclick="() => OnSelectResult.InvokeAsync(result)"
                                            class="@(ManualEntrySelection?.IgdbId == result.IgdbId
                                                ? "flex w-full items-center justify-between gap-3 rounded-xl border px-3 py-2 text-left text-sm transition border-emerald-400/60 bg-emerald-400/10 text-emerald-700 dark:text-emerald-100"
                                                : "flex w-full items-center justify-between gap-3 rounded-xl border px-3 py-2 text-left text-sm transition border-slate-200 dark:border-slate-800 bg-slate-200/40 dark:bg-slate-950/40 text-slate-700 dark:text-slate-200 hover:border-emerald-400/40")">
                                        <span>@Formatters.FormatEntryResultLabel(result.Source, result.Title, result.Platform)</span>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </div>

                @if (ManualEntrySelection is not null)
                {
                    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50 p-4">
                        <p class="text-xs uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                            Selected game
                        </p>
                        <p class="mt-2 text-sm font-semibold text-slate-900 dark:text-white">
                            @Formatters.FormatEntryResultLabel(
                                ManualEntrySelection.Source,
                                ManualEntrySelection.Title,
                                ManualEntrySelection.Platform)
                        </p>
                        @if (ManualEntrySelection.Source == "igdb")
                        {
                            <label class="mt-4 block text-xs font-medium text-slate-600 dark:text-slate-300">
                                Choose platform
                                <select value="@ManualEntryPlatformKey"
                                        @onchange="eventArgs => OnPlatformKeyChange.InvokeAsync(eventArgs.Value?.ToString() ?? string.Empty)"
                                        class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-3 py-2 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30">
                                    <option value="">Select a platform</option>
                                    @foreach (var platform in PlatformOptions)
                                    {
                                        <option @key="platform.Key" value="@platform.Key">@platform.Label</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(ManualEntryError))
                {
                    <p class="text-xs text-rose-700 dark:text-rose-300">
                        @ManualEntryError
                    </p>
                }
            </div>

            <div class="mt-6 flex shrink-0 flex-wrap items-center justify-end gap-3">
                <button type="button"
                        @onclick="OnClose"
                        class="rounded-full border border-slate-300 dark:border-slate-700 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-slate-700 dark:text-slate-200">
                    Cancel
                </button>
                <button type="button"
                        @onclick="OnSave"
                        disabled="@IsManualEntrySaving"
                        class="rounded-full bg-emerald-400 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-slate-900 transition hover:bg-emerald-300 disabled:cursor-not-allowed disabled:bg-emerald-300/60">
                    @(IsManualEntrySaving ? "Saving..." : "Save entry")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string ManualEntryDate { get; set; } = "";

    [Parameter]
    public string ManualEntryHours { get; set; } = "";

    [Parameter]
    public string ManualEntryMinutes { get; set; } = "";

    [Parameter]
    public string ManualEntrySearchQuery { get; set; } = "";

    [Parameter]
    public IReadOnlyList<ManualMappingSearchResult> ManualEntrySearchResults { get; set; } = [];

    [Parameter]
    public ManualMappingSearchResult? ManualEntrySelection { get; set; }

    [Parameter]
    public string ManualEntryPlatformKey { get; set; } = "";

    [Parameter]
    public string ManualEntryError { get; set; } = "";

    [Parameter]
    public string ManualEntrySearchError { get; set; } = "";

    [Parameter]
    public bool ManualEntryIgdbAvailable { get; set; }

    [Parameter]
    public bool IsManualEntrySearchLoading { get; set; }

    [Parameter]
    public bool IsManualEntrySaving { get; set; }

    [Parameter]
    public IReadOnlyList<(string Key, string Label)> PlatformOptions { get; set; } = [];

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnSearch { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback<string> OnDateChange { get; set; }

    [Parameter]
    public EventCallback<string> OnHoursChange { get; set; }

    [Parameter]
    public EventCallback<string> OnMinutesChange { get; set; }

    [Parameter]
    public EventCallback<string> OnSearchQueryChange { get; set; }

    [Parameter]
    public EventCallback<ManualMappingSearchResult> OnSelectResult { get; set; }

    [Parameter]
    public EventCallback<string> OnPlatformKeyChange { get; set; }
}
