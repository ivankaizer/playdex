@page "/"
@using Playdex.Web.Components

<main class="relative min-h-screen overflow-hidden bg-slate-200 dark:bg-slate-950 text-slate-900 dark:text-slate-100">
    <Background />

    <div class="relative mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
        <div class="flex justify-end mb-6">
            <ThemeToggle Theme="@_theme" OnToggle="ToggleThemeAsync" />
        </div>
        <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
            <section class="flex flex-col justify-center gap-8">
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-3 w-3 rounded-full bg-emerald-400 shadow-[0_0_14px_rgba(52,211,153,0.8)]"></span>
                    <p class="text-xs font-semibold uppercase tracking-[0.5em] text-emerald-700 dark:text-emerald-300">
                        Playdex
                    </p>
                </div>

                <div class="space-y-4">
                    <h1 class="text-balance text-4xl font-semibold leading-tight text-slate-900 dark:text-white sm:text-5xl">
                        Your cross-platform playtime, perfectly organized.
                    </h1>
                    <p class="max-w-xl text-lg text-slate-600 dark:text-slate-300">
                        Connect your gaming accounts and keep a living history of your
                        sessions, streaks, and favorite titles across platforms.
                    </p>
                </div>
            </section>

            <section class="flex items-center justify-center">
                <div class="w-full max-w-md rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/70 p-6 shadow-[0_25px_80px_rgba(15,23,42,0.65)] sm:p-8">
                    @if (_isLoggedIn)
                    {
                        <div class="space-y-5 text-center">
                            <p class="text-xs font-semibold uppercase tracking-[0.4em] text-emerald-700 dark:text-emerald-300">
                                Signed in
                            </p>
                            <div class="space-y-2">
                                <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">
                                    Welcome back
                                </h2>
                                <p class="text-sm text-slate-600 dark:text-slate-300">
                                    Logged in as
                                    <span class="font-semibold text-emerald-700 dark:text-emerald-200">
                                        @_state.ProfileLabel
                                    </span>
                                </p>
                            </div>
                            <button type="button"
                                    @onclick="OpenDashboard"
                                    class="w-full rounded-xl border border-emerald-400/60 bg-emerald-400/10 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-100 transition hover:border-emerald-300 hover:text-emerald-50">
                                Open dashboard
                            </button>
                            <button type="button"
                                    @onclick="LogoutAsync"
                                    class="w-full rounded-xl border border-rose-500/60 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-rose-700 dark:text-rose-200 transition hover:border-rose-400 hover:text-rose-700 dark:hover:text-rose-100">
                                Logout
                            </button>
                        </div>
                    }
                    else
                    {
                        <form class="space-y-5" @onsubmit="HandleSubmitAsync" @onsubmit:preventDefault>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                                Email address
                                <input type="email"
                                       placeholder="you@example.com"
                                       @bind="_email"
                                       @bind:event="oninput"
                                       class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-4 py-3 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30" />
                            </label>
                            <label class="block text-sm font-medium text-slate-700 dark:text-slate-200">
                                Password
                                <input type="password"
                                       placeholder="••••••••"
                                       @bind="_password"
                                       @bind:event="oninput"
                                       class="mt-2 w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white/90 dark:bg-slate-950/80 px-4 py-3 text-sm text-slate-900 dark:text-white outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30" />
                            </label>

                            <button type="submit"
                                    disabled="@_state.IsLoginDisabled"
                                    class="w-full rounded-xl bg-emerald-400 px-6 py-3 text-sm font-semibold text-slate-900 transition hover:bg-emerald-300 disabled:cursor-not-allowed disabled:bg-emerald-300/60">
                                @(_state.LoginStatus == HomeLoginStatus.Loading ? "Signing in..." : "Log in")
                            </button>
                        </form>
                    }

                    <div class="mt-6 text-center text-xs text-slate-500 dark:text-slate-400">
                        @if (_isLoggedIn)
                        {
                            <p class="text-emerald-700 dark:text-emerald-300">
                                Session active.
                            </p>
                        }
                        else if (_state.Error.Length > 0)
                        {
                            <p class="text-rose-700 dark:text-rose-300">@_state.Error</p>
                        }
                        else if (_state.LoginStatus == HomeLoginStatus.Success)
                        {
                            <p class="text-emerald-700 dark:text-emerald-300">
                                Signed in successfully.
                            </p>
                        }
                        else
                        {
                            <p>Need access? Ask an admin to invite you.</p>
                        }
                    </div>
                </div>
            </section>
        </div>

        <section class="mt-12 space-y-6">
            <div>
                <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">
                    Everything in one place
                </h2>
                <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
                    Keep your play history consistent, discover trends, and set goals
                    with a dashboard built for long-term tracking.
                </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-3">
                <div class="flex items-center gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 p-4 text-sm text-slate-700 dark:text-slate-200">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-400/10 text-emerald-700 dark:text-emerald-300">
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="12" cy="12" r="8"></circle>
                            <path stroke-linecap="round" d="M12 8v4l3 2"></path>
                        </svg>
                    </span>
                    <span>Track Steam and PSN playtime</span>
                </div>
                <div class="flex items-center gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 p-4 text-sm text-slate-700 dark:text-slate-200">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-400/10 text-emerald-700 dark:text-emerald-300">
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" d="M20 8v-3m0 0h-3m3 0-3.5 3.5"></path>
                            <path stroke-linecap="round" d="M4 16v3m0 0h3m-3 0 3.5-3.5"></path>
                            <path stroke-linecap="round" d="M6.5 6.5a8 8 0 0 1 11 0M6.5 17.5a8 8 0 0 0 11 0"></path>
                        </svg>
                    </span>
                    <span>Automatic polling with scheduled refresh</span>
                </div>
                <div class="flex items-center gap-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/60 p-4 text-sm text-slate-700 dark:text-slate-200">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-400/10 text-emerald-700 dark:text-emerald-300">
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="11" cy="11" r="6.5"></circle>
                            <path stroke-linecap="round" d="m16 16 4 4"></path>
                        </svg>
                    </span>
                    <span>Fast search across your library</span>
                </div>
            </div>

            <StatsRecapSection Title="Sessions recap"
                               Subtitle="Preview"
                               Summary="@PreviewRecapSummary"
                               Platforms="@PreviewRecapPlatforms"
                               TopGames="@PreviewRecapTopGames"
                               Colors="@PreviewPlatformColors" />

            <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 p-5 sm:p-6">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700 dark:text-emerald-300">
                            Most popular
                        </p>
                        <h3 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">
                            Top 5 games from recap
                        </h3>
                    </div>
                    <div class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400">
                        Jan 1 - Dec 31
                    </div>
                </div>
                <div class="mt-5 grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
                    @foreach (var game in PreviewRecapCards)
                    {
                        <div @key="game.GameId" class="group text-left">
                            <div class="w-full">
                                <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-200/50 dark:bg-slate-950/50">
                                    <div class="@($"aspect-[2/3] w-full {game.ArtClass}")"></div>
                                </div>
                                <div class="mt-3 grid grid-cols-[1fr_auto] items-start gap-3 text-sm">
                                    <span class="min-w-0 line-clamp-2 font-semibold leading-snug text-slate-900 dark:text-white">
                                        @game.Title
                                    </span>
                                    <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-200">
                                        @game.Hours
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <AppFooter />
    </div>
</main>
