{
  "name": "playdex",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "bun --cwd=web run dev",
    "web:build": "bun --cwd=web run build",
    "web:preview": "bun --cwd=web run preview",
    "user:create": "bun run scripts/create-user.ts",
    "user:password": "bun run scripts/update-user-password.ts",
    "steam:now": "bun run scripts/steam-now.ts",
    "psn:now": "bun run scripts/psn-now.ts",
    "psn:account": "bun run scripts/psn-account.ts",
    "db:test": "bun test tests/db",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "elysia": "latest",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.5",
    "psn-api": "^2.14.1"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prettier": "^3.3.3"
  },
  "module": "src/index.js"
}
