{
  "uid": "playdex-operations",
  "title": "Playdex",
  "tags": [
    "playdex"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "description": "Polling, accounts, sessions and notifications of the Playdex API. Source: observability/grafana in the Playdex repo; push changes with push.sh.",
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(playdex_poll_cycles_total, job)",
          "refId": "job"
        },
        "definition": "label_values(playdex_poll_cycles_total, job)",
        "refresh": 2,
        "current": {
          "text": "playdex-api",
          "value": "playdex-api"
        }
      },
      {
        "name": "integration",
        "label": "Integration",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(playdex_integration_state{job=\"$job\"}, integration_id)",
          "refId": "integration"
        },
        "definition": "label_values(playdex_integration_state{job=\"$job\"}, integration_id)",
        "refresh": 2,
        "sort": 3,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Polling",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Poll cycles, last 10 min",
      "description": "Completed poll cycles across all instances. 0 means polling has stopped (the 'Polling stopped' alert fires).",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(playdex_poll_cycles_total{job=\"$job\",outcome=\"completed\"}[10m])) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Failed cycles, last hour",
      "description": "Cycles that threw before polling every account (the database was down, say).",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(playdex_poll_cycles_total{job=\"$job\",outcome=\"failed\"}[1h])) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "bargauge",
      "title": "Accounts by state",
      "description": "Every Steam, PlayStation and Xbox integration, by the state the poller last saw.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (max by (integration_id, state) (playdex_integration_state{job=\"$job\"}))",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "healthy"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failing"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "paused"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "never_polled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "disabled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Polls per minute by outcome",
      "description": "success, failure, or auth_failure (the provider rejected the credential).",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(playdex_polls_total{job=\"$job\"}[5m])) * 60",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Failed polls per minute by platform",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (platform) (rate(playdex_polls_total{job=\"$job\",outcome!=\"success\"}[5m])) * 60",
          "legendFormat": "{{platform}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Poll cycle duration",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(playdex_poll_cycle_duration_seconds_bucket{job=\"$job\"}[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(playdex_poll_cycle_duration_seconds_bucket{job=\"$job\"}[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 6
      }
    },
    {
      "type": "row",
      "title": "Accounts",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Accounts",
      "description": "One row per integration. 'Since success' is the time since it was last polled successfully; 'Sessions (7d)' is what it detected. Look an id up in the admin console (/admin/integrations).",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (integration_id, user_id, platform, state) (playdex_integration_state{job=\"$job\"}) == 1",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "max by (integration_id) (playdex_integration_since_success_seconds{job=\"$job\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "max by (integration_id) (playdex_integration_failing_for_seconds{job=\"$job\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "sum by (integration_id) ((playdex_polls_total{job=\"$job\",outcome!=\"success\"} unless playdex_polls_total{job=\"$job\",outcome!=\"success\"} offset 24h) or increase(playdex_polls_total{job=\"$job\",outcome!=\"success\"}[24h]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "expr": "sum by (integration_id) ((playdex_sessions_total{job=\"$job\",event=\"started\"} unless playdex_sessions_total{job=\"$job\",event=\"started\"} offset 7d) or increase(playdex_sessions_total{job=\"$job\",event=\"started\"}[7d]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "integration_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Value #A": true
            },
            "indexByName": {
              "integration_id": 0,
              "user_id": 1,
              "platform": 2,
              "state": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7
            },
            "renameByName": {
              "integration_id": "Integration",
              "user_id": "User",
              "platform": "Platform",
              "state": "State",
              "Value #B": "Since success",
              "Value #C": "Failing for",
              "Value #D": "Failed polls (24h)",
              "Value #E": "Sessions (7d)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Since success",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "healthy": {
                        "color": "green",
                        "index": 0
                      },
                      "failing": {
                        "color": "red",
                        "index": 1
                      },
                      "paused": {
                        "color": "orange",
                        "index": 2
                      },
                      "never_polled": {
                        "color": "yellow",
                        "index": 3
                      },
                      "disabled": {
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Since success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 600
                    },
                    {
                      "color": "red",
                      "value": 3600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failing for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed polls (24h)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sessions (7d)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "row",
      "title": "Sessions and notifications",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Sessions detected",
      "description": "Sessions integrations started and ended (polling and the Playdex app).",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) ((playdex_sessions_total{job=\"$job\"} unless playdex_sessions_total{job=\"$job\"} offset $__interval) or increase(playdex_sessions_total{job=\"$job\"}[$__interval]))",
          "legendFormat": "{{event}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "interval": "5m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "Notifications by outcome",
      "description": "sent, skipped (see the reasons), retrying (Apprise failed; tried again) or failed (given up: the user never got it).",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) ((playdex_notifications_total{job=\"$job\"} unless playdex_notifications_total{job=\"$job\"} offset $__interval) or increase(playdex_notifications_total{job=\"$job\"}[$__interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "interval": "5m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "Skipped notifications by reason",
      "description": "no_channel: the user has no Telegram chat set. notifications_disabled: Apprise is not configured. ignored_game, overlapping_session: by design.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) ((playdex_notifications_total{job=\"$job\",outcome=\"skipped\"} unless playdex_notifications_total{job=\"$job\",outcome=\"skipped\"} offset $__interval) or increase(playdex_notifications_total{job=\"$job\",outcome=\"skipped\"}[$__interval]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "interval": "5m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      }
    },
    {
      "type": "table",
      "title": "Notifications per user, last 24 h",
      "description": "Sent and skipped notifications by user; failures can't be tied to a user and are in the chart above.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (user_id, kind, outcome, reason) ((playdex_notifications_total{job=\"$job\",user_id!=\"\"} unless playdex_notifications_total{job=\"$job\",user_id!=\"\"} offset 24h) or increase(playdex_notifications_total{job=\"$job\",user_id!=\"\"}[24h])) > 0",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "user_id": 0,
              "kind": 1,
              "outcome": 2,
              "reason": 3,
              "Value": 4
            },
            "renameByName": {
              "user_id": "User",
              "kind": "Kind",
              "outcome": "Outcome",
              "reason": "Reason",
              "Value": "Count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "User"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "panels": []
    },
    {
