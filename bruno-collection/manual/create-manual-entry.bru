meta {
  name: Create Manual Entry
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/manual/entries
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "date": "2024-01-15",
    "durationMinutes": 60,
    "gameId": "string?",
    "igdbId": "string?",
    "title": "string?",
    "platformKey": "string?",
    "capsuleUrl": "string?"
  }
}

docs {
  Create a manual play session entry.
}
