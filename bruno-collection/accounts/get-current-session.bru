meta {
  name: Get Current Session
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/accounts/{{accountId}}/sessions/current
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

docs {
  Get the currently active session for a specific account.
}
