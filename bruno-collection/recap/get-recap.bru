meta {
  name: Get Recap
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/recap
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

query {
  from: 2024-01-01
  to: 2024-12-31
}

headers {
  Accept: application/json
}

docs {
  Get yearly recap/wrapped data for a date range.
}
