meta {
  name: Move Sessions
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/admin/sessions/move
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "sessionIds": [
      1,
      2
    ],
    "targetCredentialId": 1
  }
}

docs {
  Admin: Move sessions to a different credential/account.
}
