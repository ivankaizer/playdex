meta {
  name: Update Platform Status
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/admin/providers/platforms/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "platform": "steam",
    "enabled": true
  }
}

docs {
  Admin: Enable or disable a provider platform.
}
