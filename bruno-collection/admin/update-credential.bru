meta {
  name: Update Credential
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/admin/credentials/{{credentialId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "apiKey": "string?",
    "user": "string?"
  }
}

docs {
  Admin: Update a credential's API key or linked user.
}
