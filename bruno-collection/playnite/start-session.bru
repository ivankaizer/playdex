meta {
  name: Start Session
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/playnite/sessions/start
  body: json
  auth: apikey
}

auth:apikey {
  key: {{playniteApiKey}}
  value: {{playniteApiKey}}
  in: header
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "gameTitle": "Elden Ring",
    "gameId": "12345",
    "gameProvider": "steam"
  }
}

docs {
  Start a new play session via the Playnite extension. Uses API key authentication.
}
