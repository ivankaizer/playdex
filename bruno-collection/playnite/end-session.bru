meta {
  name: End Session
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/playnite/sessions/end
  body: none
  auth: apikey
}

auth:apikey {
  key: {{playniteApiKey}}
  value: {{playniteApiKey}}
  in: header
}

headers {
  Accept: application/json
  Content-Type: application/json
}

docs {
  End the currently active session via the Playnite extension. Uses API key authentication.
}
