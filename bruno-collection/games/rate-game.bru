meta {
  name: Rate Game
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/games/rating
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "gameId": "string",
    "rating": 5
  }
}

docs {
  Set or update a rating for a game. Rating is an integer.
}
