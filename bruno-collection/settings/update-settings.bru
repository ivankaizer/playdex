meta {
  name: Update Settings
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "ignoreShortSessionsMinutes": 5
  }
}

docs {
  Update the current user's settings.
}
