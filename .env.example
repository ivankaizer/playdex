# Errors go to Sentry when this is set. The DSN is a public ingestion identifier, not an API access token.
SENTRY_DSN=

# Optional: use a separate Sentry project for browser errors and frontend transactions.
# If omitted, the browser receives SENTRY_DSN from the API bootstrap endpoint.
SENTRY_WEB_DSN=

SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=playdex@local
SENTRY_TRACES_SAMPLE_RATE=1.0

# Metrics, logs and traces go to an OTLP endpoint when this is set: for Grafana Cloud, the OTLP endpoint from
# "Stack > OpenTelemetry", e.g. https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
OTLP_ENDPOINT=
# Its auth header, e.g. Authorization=Basic <base64 of instanceId:token>. Not OTEL_EXPORTER_OTLP_HEADERS: Sentry's
# exporter would send that one to Sentry too.
OTLP_HEADERS=
# The service name dashboards and alerts filter on (the job label in Grafana).
OTEL_SERVICE_NAME=playdex-api

# Create this once with Telegram's BotFather. Users only provide their chat ID.
TELEGRAM_BOT_TOKEN=

# Optional for local development: the signing secret for sign-in tokens (at least 32 bytes).
# docker-compose.yml falls back to a public development-only value when this is empty.
JWT_SECRET=

# Optional for local development: encrypts Steam, PSN and OpenXBL keys in the database (at least 32 bytes).
# docker-compose.yml falls back to a public development-only value when this is empty.
CREDENTIALS_KEY=
