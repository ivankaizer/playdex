# Copy to .env and fill in. Only the first four are required.

# The name your server answers on. Its DNS A/AAAA record must point at this host (ports 80 and 443 open).
PLAYDEX_DOMAIN=playdex.example.com
# Generate each with: openssl rand -hex 32 (hex, so the password is safe inside a URL)
POSTGRES_PASSWORD=
JWT_SECRET=
# Encrypts Steam, PSN and OpenXBL keys in the database. Without it they can't be read: keep it with your backups.
CREDENTIALS_KEY=

# Image tag on ghcr.io: latest, or sha-<full commit SHA> to pin a version.
PLAYDEX_VERSION=latest

# Telegram notifications: a bot token from @BotFather. Each user then saves their chat ID in Settings.
TELEGRAM_BOT_TOKEN=

# Game search when logging sessions by hand: a Twitch developer app (https://dev.twitch.tv/console).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# AI drafts (paste text or a screenshot, get sessions). openai, or openrouter with
# AI_DRAFTS_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_DRAFTS_ENABLED=false
AI_DRAFTS_PROVIDER=openai
AI_DRAFTS_BASE_URL=
AI_DRAFTS_API_KEY=
AI_DRAFTS_MODEL=

# Error reporting (optional).
SENTRY_DSN=
